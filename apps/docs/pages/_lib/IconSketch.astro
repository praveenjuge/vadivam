---
// The homepage hero's drawing: icons sketched one after another on the 24px
// canvas, over the grid and keylines from the design guide. The drawing is
// CSS, timed below from the list of icons, and a small script pauses it while
// it's out of view.
import { iconsByName } from "vadivam/manifest";
import { canvasSize, svgPathData } from "../../../../scripts/icon-styles.mjs";

const names = [
  "rocket",
  "heart",
  "coffee",
  "camera",
  "palette",
  "cloud",
  "bell",
  "leaf",
  "cat",
  "umbrella",
  "lightbulb",
  "gift",
  "compass",
  "headphones",
  "plane",
  "flower",
] as const;
const sketches = names.map((name) => {
  const svg = iconsByName[name]?.svg;
  if (!svg) throw new Error(`Hero sketch icon "${name}" is not in the set`);
  return svgPathData(svg);
});

// Each icon has its own three-second slot in one loop through all of them:
// it fades in, draws for 1.44s, holds, and fades out by the end of its slot.
const slot = 3;
const period = slot * names.length;
const at = (seconds: number) => `${+((seconds / period) * 100).toFixed(4)}%`;
const timing = `.icon-sketch-icon {
  animation: icon-sketch ${period}s linear calc(var(--sketch-index) * ${slot}s) infinite both;
}
@keyframes icon-sketch {
  0% { stroke-dashoffset: 1; opacity: 0; }
  ${at(0.048)} { opacity: 1; }
  ${at(1.44)} { stroke-dashoffset: 0; animation-timing-function: ease-out; }
  ${at(2.52)} { stroke-dashoffset: 0; opacity: 1; }
  ${at(slot)}, 100% { stroke-dashoffset: 0; opacity: 0; }
}
/* Without motion, the first icon stays drawn. */
@media (prefers-reduced-motion: reduce) {
  .icon-sketch-icon { animation: none; opacity: 0; }
  .icon-sketch-icon[data-still] { opacity: 1; }
}`;
const gridLines = Array.from({ length: canvasSize + 1 }, (_, index) => index);
---

<svg class="icon-sketch" viewBox="-4 -4 32 32" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="iconSketchFade">
      <stop offset="0.55" stop-color="#fff" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </radialGradient>
    <mask id="iconSketchMask" maskUnits="userSpaceOnUse" x="-4" y="-4" width="32" height="32">
      <rect x="-4" y="-4" width="32" height="32" fill="url(#iconSketchFade)" />
    </mask>
  </defs>
  <g mask="url(#iconSketchMask)">
    <g class="icon-sketch-grid">
      {gridLines.map((line) => <path d={`M${line} 0V${canvasSize}M0 ${line}H${canvasSize}`} />)}
    </g>
    <g class="icon-sketch-keylines">
      <path d="M-4 12H28M12-4V28M-4-4 28 28M28-4-4 28" />
      <circle cx="12" cy="12" r="10" />
      <rect x="3" y="3" width="18" height="18" rx="2" />
      <rect x="2" y="4" width="20" height="16" rx="2" />
      <rect x="4" y="2" width="16" height="20" rx="2" />
    </g>
  </g>
  {
    sketches.map((paths, index) => (
      <g class="icon-sketch-icon" style={`--sketch-index: ${index}`} data-still={index === 0 || undefined}>
        {paths.map((d) => <path d={d} pathLength="1" />)}
      </g>
    ))
  }
</svg>
<style is:inline set:html={timing}></style>

<script>
  // Astro's client router swaps pages without reloading, so watch the drawing
  // on every page load and stop before the next swap.
  document.addEventListener("astro:page-load", () => {
    const sketch = document.querySelector(".icon-sketch");
    if (!sketch) return;
    // Entries arrive oldest first, so the last one is the current state.
    const observer = new IntersectionObserver((entries) => sketch.toggleAttribute("data-paused", !entries.at(-1)?.isIntersecting));
    observer.observe(sketch);
    document.addEventListener("astro:before-swap", () => observer.disconnect(), { once: true });
  });
</script>

<style is:global>
  /* The grid and keylines use a light blue so they read as guides, not as
     part of the icon. */
  .icon-sketch {
    --sketch-guide: oklch(0.7 0.13 240);
    display: block;
    overflow: visible;
  }
  [data-theme="dark"] .icon-sketch {
    --sketch-guide: oklch(0.62 0.14 240);
  }
  .icon-sketch-grid,
  .icon-sketch-keylines {
    fill: none;
    stroke: var(--sketch-guide);
    vector-effect: non-scaling-stroke;
  }
  .icon-sketch-grid > path,
  .icon-sketch-keylines > * {
    vector-effect: non-scaling-stroke;
  }
  .icon-sketch-grid {
    stroke-width: 1px;
    stroke-opacity: 0.16;
  }
  .icon-sketch-keylines {
    stroke-width: 1px;
    stroke-opacity: 0.5;
  }
  .icon-sketch-icon {
    fill: none;
    stroke: var(--color-foreground);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
  }
  /* An off-screen animation still restyles every frame, so the drawing pauses
     while it's out of view. */
  .icon-sketch[data-paused] .icon-sketch-icon {
    animation-play-state: paused;
  }
</style>
