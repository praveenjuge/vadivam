---
// The homepage hero's drawing: icons sketched one after another on the 24px
// canvas, over the grid and keylines from the design guide. Pure CSS, so it
// costs no script; `.icon-sketch` in theme.css holds the timing.
import { iconsByName } from "vadivam/manifest";

// The keyframes in theme.css assume eight icons, three seconds each.
const names = ["rocket", "heart", "coffee", "camera", "palette", "cloud", "bell", "leaf"] as const;
const sketches = names.map((name) => {
  const svg = iconsByName[name]?.svg;
  if (!svg) throw new Error(`Hero sketch icon "${name}" is not in the set`);
  return Array.from(svg.matchAll(/ d="([^"]*)"/g), (match) => match[1]);
});
const gridLines = Array.from({ length: 25 }, (_, index) => index);
---

<svg class="icon-sketch" viewBox="-4 -4 32 32" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="iconSketchFade">
      <stop offset="0.55" stop-color="#fff" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </radialGradient>
    <mask id="iconSketchMask" maskUnits="userSpaceOnUse" x="-4" y="-4" width="32" height="32">
      <rect x="-4" y="-4" width="32" height="32" fill="url(#iconSketchFade)" />
    </mask>
  </defs>
  <g mask="url(#iconSketchMask)">
    <g class="icon-sketch-grid">
      {gridLines.map((line) => <path d={`M${line} 0V24M0 ${line}H24`} />)}
    </g>
    <g class="icon-sketch-keylines">
      <path d="M-4 12H28M12-4V28M-4-4 28 28M28-4-4 28" />
      <circle cx="12" cy="12" r="10" />
      <rect x="3" y="3" width="18" height="18" rx="2" />
      <rect x="2" y="4" width="20" height="16" rx="2" />
      <rect x="4" y="2" width="16" height="20" rx="2" />
    </g>
  </g>
  {
    sketches.map((paths, index) => (
      <g class="icon-sketch-icon" style={`--sketch-index: ${index}`} data-still={index === 0 || undefined}>
        {paths.map((d) => <path d={d} pathLength="1" />)}
      </g>
    ))
  }
</svg>
