---
// Inline a Vadivam icon for page chrome, so the site uses its own set.
import { iconsByName } from "vadivam/manifest";
import { resizeSvg } from "../../../../scripts/icon-styles.mjs";

interface Props {
  name: keyof typeof iconsByName;
  size?: number;
  class?: string;
}

const { name, size = 16, class: className } = Astro.props;
const svg = resizeSvg(iconsByName[name].svg, size).replace("<svg ", '<svg aria-hidden="true" focusable="false" ');
---

<span class:list={["inline-flex flex-none", className]} set:html={svg} />
