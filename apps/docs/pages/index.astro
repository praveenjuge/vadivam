---
import PageLayout from "blume/components/layout/PageLayout.astro";
import GithubInfo from "blume/components/content/GithubInfo.astro";
import data from "blume:data";
import { existsSync } from "node:fs";
import path from "node:path";
import { categories, icons, iconsByName } from "vadivam/manifest";
import { pathIconSvg, styles, svgInner, svgPathData } from "../../../scripts/icon-styles.mjs";
import { frameworks, targetsById } from "../../../scripts/packages.mjs";
import { gridChunkSize, iconDataFiles } from "../../../scripts/web-data.mjs";
import pkg from "../../../package.json";
import { iconLastmods } from "../scripts/icon-lastmods.mjs";
import ActionMenus from "./_lib/ActionMenus.astro";
import Customizer from "./_lib/Customizer.astro";
import VIcon from "./_lib/VIcon.astro";
import { agentPrompt } from "./_lib/agent-prompt";
import IconSketch from "./_lib/IconSketch.astro";
import { sizePresets } from "./_lib/site";
import { buildSnippetTemplates, serializeForScript } from "./_lib/snippet-templates";

const { config } = data;

const codeTabs = [...frameworks.map(({ id, label }) => ({ id, label })), { id: "svg", label: "SVG" }];
// The hero's sentence names the main packages, each with its logo from
// public/frameworks, then the tools.
type HeroLink = { label: string; href: string; logo?: string; logoClass?: string; icon?: "file-code" | "bot"; external?: boolean };
const heroPackages = [
  ["react", "react"],
  ["react-native", "react"],
  ["vue", "vue"],
  ["svelte", "svelte"],
  ["solid", "solid"],
  ["preact", "preact"],
  ["astro", "astro"],
  ["angular", "angular"],
] as const;
const packageLinks: HeroLink[] = [
  ...heroPackages.map(([id, logo]) => ({ label: targetsById[id].label, href: targetsById[id].documentation, logo })),
  { label: "SVG", href: targetsById.core.documentation, icon: "file-code" },
];
const toolLinks: HeroLink[] = [
  { label: "shadcn/ui", href: "/docs/shadcn", logo: "shadcn", logoClass: "dark:invert" },
  { label: "MCP", href: "/docs/mcp", icon: "bot" },
  { label: "Iconify", href: "https://icon-sets.iconify.design/vadivam/", logo: "iconify", external: true },
  { label: "Figma", href: "https://www.figma.com/community/plugin/1661323620355050204/vadivam-icons", logo: "figma", external: true },
];
const logoClass = "me-1 inline-block size-3.5 align-[-0.15em] object-contain";
const inlineLinkClass =
  "whitespace-nowrap text-foreground no-underline decoration-border underline-offset-4 transition-colors hover:underline hover:decoration-current focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent";
const iconButtonClass =
  "grid size-7 flex-none place-items-center rounded-md border-0 bg-transparent p-0 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent disabled:opacity-40 disabled:hover:bg-transparent";
const smallCopyClass =
  "grid size-5 flex-none place-items-center rounded border-0 bg-transparent p-0 text-muted-foreground transition-colors hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent";

// The vadivam "search" and "x" icons used as affordances in the search field.
// Their stroke follows `currentColor`, so the wrapper's text color styles them.
const searchIconSvg = iconsByName.search?.svg ?? "";
const clearIconSvg = iconsByName.x?.svg ?? "";

// Category filter options after "All": alphabetical, each with its icon count.
const categoryCounts = new Map<string, number>();
for (const icon of icons) {
  for (const id of icon.categories) categoryCounts.set(id, (categoryCounts.get(id) ?? 0) + 1);
}
const categoryOptions = [...categories].sort((left, right) => left.title.localeCompare(right.title));

// Tiles carry only their path data; size, stroke, and caps come from CSS, and
// the client rebuilds each icon's SVG from these paths, as does the Solid
// toggle from the solid paths it fetches. Fail the build if that would not
// reproduce the manifest exactly.
const tilePaths = new Map<string, string>();
for (const icon of icons) {
  if (!icon.solid) throw new Error(`${icon.name} has no solid twin`);
  for (const [style, svg] of [[styles.outline, icon.svg], [styles.solid, icon.solid.svg]] as const) {
    if (pathIconSvg(style, svgPathData(svg)) !== svg) {
      throw new Error(`${style.sourceDirectory}/${icon.name}.svg can't be rebuilt from its paths`);
    }
  }
  tilePaths.set(icon.name, svgInner(icon.svg));
}

// Search placeholder examples, cycled until the visitor types. Fail the build
// if one is renamed or removed.
const searchExamples = ["coffee", "rocket", "cat", "calendar", "heart", "cloud", "settings", "palette"];
for (const name of searchExamples) {
  if (!tilePaths.has(name)) throw new Error(`Search example "${name}" is not in the set`);
}
const iconCount = icons.length.toLocaleString("en-US");

// Chunks stack without ragged rows (see `.icon-chunk`), and each one names the
// file holding its solid paths.
const chunks = Array.from({ length: Math.ceil(icons.length / gridChunkSize) }, (_, index) =>
  icons.slice(index * gridChunkSize, (index + 1) * gridChunkSize),
);

// `bun run icons:build` writes these files from the same manifest, so a
// missing one means the public folder is stale.
const { searchIndex, solidChunks } = iconDataFiles(icons, categories);
for (const file of [searchIndex, ...solidChunks]) {
  if (!existsSync(path.join(process.cwd(), "public", file.path))) {
    throw new Error(`public/${file.path} is missing. Run \`bun run icons:build\`.`);
  }
}

const snippetTemplates = serializeForScript(await buildSnippetTemplates(config.codeThemes));
// One switch: a click anywhere flips the style, and the active half is shaded.
const styleSegmentClass =
  "inline-flex items-center gap-1.5 rounded-md px-2 text-xs text-muted-foreground transition-colors group-hover:text-foreground [&>svg]:size-3.5 [&>svg]:flex-none";
const outlineStyleIcon = iconsByName.square?.svg ?? "";
const solidStyleIcon = iconsByName.square?.solid?.svg ?? "";

// PageLayout's built-in JSON-LD is disabled so this page can declare the site
// identity plus the library's software entity in one graph.
const site = config.site?.replace(/\/$/, "");
// The catalog changes when an icon does, so date the page by its newest icon.
const lastModified = [...iconLastmods().values()].sort().at(-1);
const structuredData = site
  ? {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": `${site}#website`,
          name: config.title,
          url: `${site}/`,
          description: config.description,
        },
        {
          "@type": "WebPage",
          "@id": `${site}/#page`,
          name: "Vadivam — 24px outline icons",
          url: `${site}/`,
          description: config.description,
          inLanguage: "en",
          isPartOf: { "@id": `${site}#website` },
          about: { "@id": `${site}#software` },
          ...(lastModified && { dateModified: lastModified }),
        },
        {
          "@type": "SoftwareApplication",
          "@id": `${site}#software`,
          name: config.title,
          url: `${site}/`,
          description: config.description,
          applicationCategory: "DesignApplication",
          operatingSystem: "Any",
          softwareVersion: pkg.version,
          author: { "@type": "Person", name: "Praveen Juge", url: "https://github.com/praveenjuge" },
          license: "https://github.com/praveenjuge/vadivam/blob/main/LICENSE",
          screenshot: `${site}/preview.png`,
          offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
        },
      ],
    }
  : null;
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  favicon={config.favicon}
  appleIcon={config.appleIcon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  x={config.x}
  structuredDataEnabled={false}
  page={{ title: "Vadivam — 24px outline icons", description: config.description }}
>
  {/* Keep the JSON-LD at the top of the body: the icon grid below inlines
      roughly 1 MB of SVG, and crawlers that truncate the response would
      otherwise never reach a script placed after it. */}
  {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}

  <main id="iconExplorer" class="w-full px-4 pb-8 md:px-6">
    <header class="grid gap-x-10 gap-y-5 pt-6 pb-6 md:grid-cols-[minmax(0,1fr)_auto] md:items-center">
      <div class="grid min-w-0 gap-2.5">
        <p class="m-0 flex flex-wrap gap-x-3 gap-y-1 font-mono text-[0.7rem] uppercase tracking-[0.08em] text-muted-foreground">
          <span>{iconCount} icons</span>
          <span aria-hidden="true">·</span>
          <span>24px grid</span>
          <span aria-hidden="true">·</span>
          <span>2px stroke</span>
          <span aria-hidden="true">·</span>
          <span>MIT</span>
        </p>
        <h1 class="m-0 text-balance text-[clamp(1.625rem,3vw,2.25rem)] font-semibold leading-[1.1] tracking-[-0.03em]">
          Icons shaped for interfaces.
        </h1>
        <p class="m-0 max-w-[62rem] text-balance text-sm leading-relaxed text-muted-foreground">
          <em class="text-foreground">Vadivam</em> (<span lang="ta">வடிவம்</span>) is Tamil for “shape.” Free, open-source icons for{" "}
          {packageLinks.map((link, index) => (
            <Fragment>
              {index > 0 && (index === packageLinks.length - 1 ? ", and " : ", ")}
              <a class={inlineLinkClass} href={link.href}>
                {link.logo ? <img class:list={[logoClass, link.logoClass]} src={`/frameworks/${link.logo}.svg`} width="14" height="14" alt="" /> : <VIcon name={link.icon!} size={14} class="me-1 align-[-0.15em]" />}{link.label}
              </a>
            </Fragment>
          ))}, with{" "}
          {toolLinks.map((link, index) => (
            <Fragment>
              {index > 0 && (index === toolLinks.length - 1 ? ", and " : ", ")}
              <a class={inlineLinkClass} href={link.href} {...(link.external && { target: "_blank", rel: "noreferrer" })}>
                {link.logo ? <img class:list={[logoClass, link.logoClass]} src={`/frameworks/${link.logo}.svg`} width="14" height="14" alt="" /> : <VIcon name={link.icon!} size={14} class="me-1 align-[-0.15em]" />}{link.label}
              </a>
            </Fragment>
          ))}.
        </p>
        <div class="pt-1">
          <button
            class="group inline-flex h-8 items-center gap-1.5 rounded-lg border-0 bg-foreground px-3 text-[0.8125rem] font-medium text-background shadow-sm transition-opacity hover:opacity-85 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background"
            type="button"
            id="agentPromptCopy"
          >
            <span class="flex group-data-[state]:hidden"><VIcon name="sparkles" size={14} /></span>
            <span class="hidden group-data-[state=copied]:flex"><VIcon name="check" size={14} /></span>
            <span class="hidden group-data-[state=failed]:flex"><VIcon name="x" size={14} /></span>
            <span class="group-data-[state]:hidden">Copy prompt for AI agents</span>
            <span class="hidden group-data-[state=copied]:inline">Copied. Paste it into your agent</span>
            <span class="hidden group-data-[state=failed]:inline">Your browser blocked copying. Copy it from below</span>
            <span class="flex transition-transform group-hover:translate-x-0.5 group-data-[state]:hidden"><VIcon name="arrow-right" size={13} /></span>
          </button>
          <span class="sr-only" id="agentPromptStatus" aria-live="polite"></span>
          {/* Shown, with its text selected, only when the browser refuses the clipboard. */}
          <textarea
            class="mt-3 block h-40 w-full max-w-[62rem] resize-y rounded-lg border border-border bg-muted/40 p-3 font-mono text-[0.75rem] leading-relaxed text-foreground outline-none focus:border-accent"
            id="agentPromptText"
            aria-label="Prompt for AI agents"
            readonly
            hidden
          >{agentPrompt}</textarea>
        </div>
      </div>
      <div class="hidden size-36 md:block lg:size-40">
        <IconSketch />
      </div>
    </header>

    <section aria-label="Icon library">
      {/* Sticky under Blume's 4rem header, so search stays at hand while browsing. */}
      <div class="sticky top-16 z-30 -mx-4 flex items-center gap-2 border-b border-border bg-background/95 px-4 py-2.5 backdrop-blur md:-mx-6 md:px-6">
        <div class="relative min-w-0 flex-1">
          <span
            class="pointer-events-none absolute inset-y-0 start-0 grid w-10 place-items-center text-muted-foreground [&>svg]:size-4"
            aria-hidden="true"
            set:html={searchIconSvg}
          />
          <input
            class="peer w-full rounded-lg border border-border bg-background py-2 ps-10 pe-3 text-base text-foreground outline-none placeholder:text-muted-foreground md:pe-12 [&:not(:placeholder-shown)]:pe-10 focus:border-accent focus-visible:outline-none md:text-sm [&::-webkit-search-cancel-button]:hidden [&::-webkit-search-decoration]:hidden"
            id="iconSearch"
            type="search"
            placeholder={`Search ${iconCount} icons`}
            aria-label="Search icons"
            data-examples={searchExamples.join(" ")}
            data-index={`/${searchIndex.path}`}
            aria-describedby="resultCount"
            aria-keyshortcuts="/"
            autocomplete="off"
            spellcheck="false"
          />
          <kbd class="pointer-events-none absolute end-3 top-1/2 hidden -translate-y-1/2 rounded border border-border px-1.5 font-mono text-[0.65rem] leading-4 text-muted-foreground peer-focus:hidden peer-[:not(:placeholder-shown)]:hidden md:block" aria-hidden="true">/</kbd>
          <button
            class="absolute inset-y-0 end-0 grid w-10 place-items-center rounded-lg border-0 bg-transparent p-0 text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-inset [&>svg]:size-4"
            id="iconSearchClear"
            type="button"
            aria-label="Clear search"
            hidden
            set:html={clearIconSvg}
          />
        </div>
        <button
          class="group flex flex-none cursor-pointer items-stretch gap-0.5 self-stretch rounded-lg border border-border bg-background p-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          type="button"
          role="switch"
          aria-checked="false"
          aria-label="Solid icons"
          id="iconStyle"
        >
          <span class={`${styleSegmentClass} group-aria-[checked=false]:bg-muted group-aria-[checked=false]:text-foreground`} aria-hidden="true">
            <Fragment set:html={outlineStyleIcon} /><span class="hidden sm:inline">Outline</span>
          </span>
          <span class={`${styleSegmentClass} group-aria-checked:bg-muted group-aria-checked:text-foreground`} aria-hidden="true">
            <Fragment set:html={solidStyleIcon} /><span class="hidden sm:inline">Solid</span>
          </span>
        </button>
        <span class="relative flex w-[7.5rem] flex-none sm:w-auto">
          <select
            class="w-full cursor-pointer appearance-none rounded-lg border border-border bg-background py-2 ps-3 pe-9 text-base text-foreground outline-none focus:border-accent md:text-sm"
            id="iconCategory"
            aria-label="Filter by category"
          >
            <option value="">All</option>
            {categoryOptions.map((category) => (
              <option value={category.id}>{category.title} ({categoryCounts.get(category.id) ?? 0})</option>
            ))}
          </select>
          <VIcon name="chevron-down" size={16} class="pointer-events-none absolute inset-y-0 end-3 items-center text-muted-foreground" />
        </span>
        <p class="sr-only" id="resultCount" aria-live="polite">{icons.length} icons</p>
      </div>

      <div class="icon-browser pt-3" id="iconBrowser" style={`--chunk-size: ${gridChunkSize}`}>
        <div class="icon-grid" id="iconGrid">
          {
            chunks.map((chunk, index) => (
              <div class="icon-chunk" data-solid={`/${solidChunks[index]!.path}`}>
                {/* A click opens the drawer, so hovering a tile shouldn't
                    prefetch its page the way Astro prefetches other links. */}
                {chunk.map((icon) => (
                  <a href={`/icons/${icon.name}`} aria-label={icon.name} data-astro-prefetch="false"><svg viewBox="0 0 24 24" set:html={tilePaths.get(icon.name)} /></a>
                ))}
              </div>
            ))
          }
        </div>
        <div id="iconResults" aria-label="Search results" hidden></div>
      </div>
      <div
        class="pointer-events-none fixed z-50 w-max rounded-blume border border-border bg-background px-3 py-2 font-sans text-sm leading-5 text-muted-foreground shadow-lg"
        id="iconTooltip"
        role="tooltip"
        hidden
      ></div>

      <div class="grid justify-items-center gap-3 py-16 text-center" id="emptyState" hidden>
        <p class="m-0 text-sm text-foreground">No icons match <span id="emptyQuery"></span>.</p>
        <p class="m-0 max-w-[40ch] text-xs text-muted-foreground">Try a broader word or another category. Missing something? Request it on GitHub.</p>
        <div class="flex flex-wrap justify-center gap-2">
          <button class="rounded-md border border-border bg-background px-3 py-1.5 text-xs text-foreground transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent" type="button" id="emptyReset">Clear filters</button>
          <a class="rounded-md border border-border px-3 py-1.5 text-xs text-foreground no-underline transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent" href="https://github.com/praveenjuge/vadivam/issues/new" target="_blank" rel="noreferrer">Request an icon</a>
        </div>
      </div>
    </section>
  </main>

  <aside
    class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-border bg-background text-foreground shadow-[0_-12px_40px_rgb(0_0_0/0.1)] transition-transform duration-200 ease-out data-[open]:translate-y-0 motion-reduce:transition-none"
    id="iconDrawer"
    aria-labelledby="drawerName"
    inert
  >
    <div class="flex max-h-[min(85dvh,30rem)] w-full flex-col">
      <div class="grid touch-none place-items-center pt-2 md:hidden" id="drawerHandle" aria-hidden="true">
        <span class="h-1 w-10 rounded-full bg-border"></span>
      </div>

      <header class="flex touch-pan-y items-center gap-3 px-4 py-2.5 md:px-6" id="drawerHeader">
        <div class="grid size-10 flex-none place-items-center rounded-md bg-accent/10 text-accent" data-icon-preview="24" aria-hidden="true"></div>
        <div class="grid min-w-0 flex-1 gap-0.5">
          <div class="flex min-w-0 items-center gap-1">
            <h2 class="m-0 truncate text-sm font-semibold leading-tight outline-none" id="drawerName" tabindex="-1"></h2>
            <button class={smallCopyClass} type="button" data-action="copy-name" aria-label="Copy icon name"><VIcon name="copy" size={13} /></button>
          </div>
          <div class="flex min-w-0 items-center gap-1">
            <p class="m-0 truncate font-mono text-xs text-muted-foreground" id="drawerComponent"></p>
            <button class={smallCopyClass} type="button" data-action="copy-component" aria-label="Copy component name"><VIcon name="copy" size={13} /></button>
          </div>
        </div>
        <div class="flex flex-none items-center gap-0.5">
          <button class={iconButtonClass} type="button" id="drawerPrev" aria-label="Previous icon" aria-keyshortcuts="ArrowLeft"><VIcon name="chevron-left" size={18} /></button>
          <button class={iconButtonClass} type="button" id="drawerNext" aria-label="Next icon" aria-keyshortcuts="ArrowRight"><VIcon name="chevron-right" size={18} /></button>
          <a class:list={[iconButtonClass, "no-underline"]} id="drawerOpenPage" href="#" aria-label="Open icon page"><VIcon name="arrow-up-right" size={18} /></a>
          <button class={iconButtonClass} type="button" id="drawerClose" aria-label="Close" aria-keyshortcuts="Escape"><VIcon name="x" size={18} /></button>
        </div>
      </header>

      <div class="grid min-h-0 flex-1 overflow-y-auto border-t border-border md:grid-cols-[minmax(0,1fr)_17rem] md:overflow-hidden lg:grid-cols-[minmax(0,1fr)_17rem_17rem]">
        <section class="order-2 grid min-w-0 content-start gap-2.5 px-4 py-3 md:order-1 md:overflow-y-auto md:px-6" aria-label="Code">
          <div class="flex gap-1 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" role="tablist" aria-label="Framework snippet">
            {
              codeTabs.map((tab, index) => (
                <button
                  class="flex-none rounded-md border border-transparent px-2 py-1 text-xs text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent aria-selected:border-accent aria-selected:bg-accent aria-selected:text-accent-foreground"
                  type="button"
                  role="tab"
                  data-tab={tab.id}
                  aria-selected={index === 0 ? "true" : "false"}
                  aria-controls="drawerCode"
                >
                  {tab.label}
                </button>
              ))
            }
          </div>
          <div class="relative min-w-0">
            <div class="prose max-w-none" id="drawerCode" role="tabpanel"></div>
            <button
              class="absolute end-1.5 top-1.5 inline-flex items-center gap-1 rounded-md border border-border bg-background px-2 py-0.5 text-[0.68rem] transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
              type="button"
              data-action="copy-code"
            ><VIcon name="copy" size={12} /><span>Copy</span></button>
          </div>
          <dl class="m-0 grid gap-1.5 text-xs" id="drawerMeta">
            <div class="flex flex-wrap items-baseline gap-1.5">
              <dt class="text-muted-foreground">Categories</dt>
              <dd class="m-0 flex flex-wrap gap-1" id="drawerCategories"></dd>
            </div>
            <div class="flex flex-wrap items-baseline gap-1.5">
              <dt class="text-muted-foreground">Tags</dt>
              <dd class="m-0 flex flex-wrap gap-1" id="drawerTags"></dd>
            </div>
          </dl>
        </section>

        <section class="order-1 grid content-start gap-3 border-b border-border px-4 py-3 md:order-2 md:overflow-y-auto md:border-b-0 md:border-l lg:contents" aria-label="Customize and export">
          <div class="grid content-start gap-3 lg:order-2 lg:overflow-y-auto lg:border-l lg:border-border lg:px-4 lg:py-3">
          <div class="flex flex-wrap items-center gap-1.5">
            <button
              class="inline-flex items-center gap-1.5 rounded-md border border-accent bg-accent px-2.5 py-1.5 text-xs text-accent-foreground transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
              type="button"
              data-action="copy-svg"
            ><VIcon name="code" size={14} /><span>Copy SVG</span></button>
            <ActionMenus id="drawerMenu" />
            <span class="text-xs text-muted-foreground" id="drawerStatus" aria-live="polite"></span>
          </div>
          <div class="flex items-end justify-between gap-2 rounded-md border border-border px-3 py-2.5 text-foreground" aria-label="Size previews">
            {sizePresets.map((size) => (
              <div class="grid justify-items-center gap-1">
                <div class="grid place-items-center" data-icon-preview={size}></div>
                <span class="font-mono text-[0.65rem] text-muted-foreground">{size}</span>
              </div>
            ))}
          </div>
          </div>
          <details class="group lg:order-3 lg:overflow-y-auto lg:border-l lg:border-border lg:px-4 lg:py-3" id="drawerCustomize">
            <summary class="flex cursor-pointer list-none items-center justify-between text-xs font-medium text-foreground [&::-webkit-details-marker]:hidden">
              Customize
              <span class="text-muted-foreground transition-transform group-open:rotate-180"><VIcon name="chevron-down" size={14} /></span>
            </summary>
            <Customizer compact class="pt-3" />
          </details>
        </section>
      </div>
    </div>
  </aside>

  <footer slot="footer" class="mx-auto w-full max-w-2xl px-4 pb-10 md:px-6">
    <GithubInfo />
  </footer>

  <script is:inline type="application/json" id="snippetTemplates" set:html={snippetTemplates}></script>
  <script is:inline type="application/json" id="siteVersion" set:html={JSON.stringify(pkg.version)}></script>

  <script>
    import { iconDefaults } from "../../../scripts/snippets.mjs";
    import { createDrawer } from "./_lib/home/drawer";
    import { createGrid } from "./_lib/home/grid";
    import { animatePlaceholder } from "./_lib/home/placeholder";
    import { createSearch } from "./_lib/home/search";
    import { createStyleSwitch } from "./_lib/home/style-switch";
    import { createTooltip } from "./_lib/home/tooltip";
    import { copyText, createSettingsStore, readTemplates } from "./_lib/icon-tools";
    import { styleFromUrl } from "./_lib/site";

    // Astro's client router swaps pages without reloading, and a bundled
    // script runs only once, so set the page up on every page load and tear
    // down the window and document listeners before the next swap.
    document.addEventListener("astro:page-load", () => {
      if (!document.querySelector("#iconExplorer")) return;
      const lifecycle = new AbortController();
      const { signal } = lifecycle;
      document.addEventListener("astro:before-swap", () => lifecycle.abort(), { once: true });

      const browser = document.querySelector<HTMLElement>("#iconBrowser")!;
      const store = createSettingsStore();
      // Search results render in chunks the size of the grid's.
      const chunkSize = Number(browser.style.getPropertyValue("--chunk-size"));

      const grid = createGrid(document.querySelector<HTMLElement>("#iconGrid")!, signal);
      const search = createSearch(grid, chunkSize, signal);
      animatePlaceholder(search.input, signal);
      const tooltip = createTooltip(browser, signal);
      const drawer = createDrawer({
        grid,
        search,
        store,
        templates: readTemplates("snippetTemplates"),
        version: JSON.parse(document.getElementById("siteVersion")?.textContent ?? '""'),
        hideTooltip: tooltip.hide,
        signal,
      });
      const styleSwitch = createStyleSwitch(grid, search, drawer.selectedEntry);
      search.onFilter(drawer.followSelection);
      styleSwitch.onChange(drawer.restyle);

      // The grid previews the customizer's stroke width and color live.
      store.subscribe((settings) => {
        browser.style.setProperty("--icon-stroke", String(settings.strokeWidth));
        if (settings.color === iconDefaults.color) browser.style.removeProperty("--icon-color");
        else browser.style.setProperty("--icon-color", settings.color);
        drawer.render();
      });

      const agentPromptText = document.querySelector<HTMLTextAreaElement>("#agentPromptText")!;
      const agentPromptStatus = document.querySelector<HTMLElement>("#agentPromptStatus")!;
      let agentPromptTimer: ReturnType<typeof setTimeout> | undefined;
      document.querySelector("#agentPromptCopy")?.addEventListener("click", async (event) => {
        const button = event.currentTarget as HTMLButtonElement;
        let copied = true;
        try {
          await copyText(agentPromptText.value);
        } catch {
          // Clipboard access can be refused; show the prompt selected so it can be copied by hand.
          copied = false;
          agentPromptText.hidden = false;
          agentPromptText.focus();
          agentPromptText.select();
        }
        button.dataset.state = copied ? "copied" : "failed";
        agentPromptStatus.textContent = copied
          ? "Prompt copied. Paste it into your agent."
          : "Your browser blocked copying. The prompt is selected below.";
        clearTimeout(agentPromptTimer);
        agentPromptTimer = setTimeout(() => {
          delete button.dataset.state;
          agentPromptStatus.textContent = "";
        }, 2400);
      });
      signal.addEventListener("abort", () => clearTimeout(agentPromptTimer));

      // Deep links: `/?icon=name` opens the drawer on that icon, and
      // `/?style=solid` shows the solid icons.
      drawer.openLinked();
      if (styleFromUrl() === "solid") styleSwitch.setStyle("solid", { updateUrl: false });
    });
  </script>
</PageLayout>

<style is:global>
  html,
  body {
    overflow-x: clip;
  }

  /* Compact the Shiki-highlighted drawer snippet. The ID selector outranks the
     shared `.prose` code rules for layout while leaving the theme's colors and
     transparent background (set with !important) untouched. Blume keeps the code
     block's horizontal padding on the inner `code` (so long lines scroll past a
     static pre), so the pre carries only vertical padding — adding horizontal
     padding here too would double the left inset. */
  #drawerCode.prose pre.astro-code {
    margin: 0;
    max-height: 9rem;
    min-height: 4.5rem;
    overflow-y: auto;
    padding: 0.5rem 0;
    font-size: 0.72rem;
    line-height: 1.5;
    scrollbar-width: thin;
  }

  /* The end padding leaves room for the copy button over the first line. */
  #drawerCode.prose pre.astro-code > code {
    padding: 0 4.5rem 0 0.75rem;
  }
</style>
