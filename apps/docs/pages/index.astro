---
import PageLayout from "blume/components/layout/PageLayout.astro";
import Icon from "blume/components/Icon.astro";
import GithubInfo from "blume/components/content/GithubInfo.astro";
import Tooltip from "blume/components/content/Tooltip.astro";
import data from "blume:data";
import { highlightCode } from "blume/markdown";
import { icons, iconsByName } from "vadivam/manifest";
import pkg from "../../../package.json";

const { config } = data;

const npmIcon = `<svg viewBox="0 0 2500 2500" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path fill="#c00" d="M0 0h2500v2500H0z"/><path fill="#fff" d="M1241.5 268.5h-973v1962.9h972.9V763.5h495v1467.9h495V268.5z"/></svg>`;
const figmaIcon = `<svg viewBox="0 0 38 57" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path fill="#F24E1E" d="M0 9.5C0 4.253 4.253 0 9.5 0H19v19H9.5C4.253 19 0 14.747 0 9.5Z"/><path fill="#FF7262" d="M19 0h9.5C33.747 0 38 4.253 38 9.5S33.747 19 28.5 19H19V0Z"/><path fill="#A259FF" d="M0 28.5C0 23.253 4.253 19 9.5 19H19v19H9.5C4.253 38 0 33.747 0 28.5Z"/><path fill="#1ABCFE" d="M19 19h9.5C33.747 19 38 23.253 38 28.5S33.747 38 28.5 38H19V19Z"/><path fill="#0ACF83" d="M0 47.5C0 42.253 4.253 38 9.5 38H19v9.5C19 52.747 14.747 57 9.5 57S0 52.747 0 47.5Z"/></svg>`;
const twitterIcon = `<svg viewBox="0 0 256 209" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid" aria-hidden="true" focusable="false"><path fill="#55acee" d="M256 25.45c-9.42 4.177-19.542 7-30.166 8.27 10.845-6.5 19.172-16.793 23.093-29.057a105.183 105.183 0 0 1-33.351 12.745C205.995 7.201 192.346.822 177.239.822c-29.006 0-52.523 23.516-52.523 52.52 0 4.117.465 8.125 1.36 11.97-43.65-2.191-82.35-23.1-108.255-54.876-4.52 7.757-7.11 16.78-7.11 26.404 0 18.222 9.273 34.297 23.365 43.716a52.312 52.312 0 0 1-23.79-6.57c-.003.22-.003.44-.003.661 0 25.447 18.104 46.675 42.13 51.5a52.592 52.592 0 0 1-23.718.9c6.683 20.866 26.08 36.05 49.062 36.475-17.975 14.086-40.622 22.483-65.228 22.483-4.24 0-8.42-.249-12.529-.734 23.243 14.902 50.85 23.597 80.51 23.597 96.607 0 149.434-80.031 149.434-149.435 0-2.278-.05-4.543-.152-6.795A106.748 106.748 0 0 0 256 25.45"/></svg>`;

type ProjectLink = {
  href: string;
  label: string;
  title: string;
  icon?: string;
  iconSrc?: string;
  darkIconSrc?: string;
};

// Framework marks are vendored from SVGL. React Native shares React's mark.
const links: ProjectLink[] = [
  { href: "https://www.npmjs.com/package/vadivam", label: "vadivam", title: "vadivam — SVG and JavaScript", icon: npmIcon },
  { href: "https://www.npmjs.com/package/vadivam-react", label: "React", title: "vadivam-react", iconSrc: "/frameworks/react-light.svg", darkIconSrc: "/frameworks/react-dark.svg" },
  { href: "https://www.npmjs.com/package/vadivam-react-native", label: "React Native", title: "vadivam-react-native", iconSrc: "/frameworks/react-light.svg", darkIconSrc: "/frameworks/react-dark.svg" },
  { href: "https://www.npmjs.com/package/vadivam-vue", label: "Vue", title: "vadivam-vue", iconSrc: "/frameworks/vue.svg" },
  { href: "https://www.npmjs.com/package/vadivam-svelte", label: "Svelte", title: "vadivam-svelte", iconSrc: "/frameworks/svelte.svg" },
  { href: "https://www.npmjs.com/package/vadivam-solid", label: "Solid", title: "vadivam-solid", iconSrc: "/frameworks/solid.svg" },
  { href: "https://www.npmjs.com/package/vadivam-angular", label: "Angular", title: "vadivam-angular", iconSrc: "/frameworks/angular.svg" },
  { href: "https://www.npmjs.com/package/vadivam-astro", label: "Astro", title: "vadivam-astro", iconSrc: "/frameworks/astro-light.svg", darkIconSrc: "/frameworks/astro-dark.svg" },
  { href: "https://www.npmjs.com/package/vadivam-preact", label: "Preact", title: "vadivam-preact", iconSrc: "/frameworks/preact.svg" },
  {
    href: "https://www.figma.com/community/file/1661416202515574840/vadivam-icons",
    label: "Figma File",
    title: "Vadivam icons on Figma",
    icon: figmaIcon,
  },
  {
    href: "https://www.figma.com/community/plugin/1661323620355050204/vadivam-icons",
    label: "Figma Plugin",
    title: "Vadivam Icons Figma plugin",
    icon: figmaIcon,
  },
  { href: "https://icon-sets.iconify.design/vadivam/", label: "Iconify", title: "Vadivam icons on Iconify", iconSrc: "/frameworks/iconify.svg" },
  { href: "https://twitter.com/praveenjuge", label: "Twitter", title: "Praveen Juge on Twitter", icon: twitterIcon },
];

const codeTabs = [
  { id: "react", label: "React" },
  { id: "vue", label: "Vue" },
  { id: "svelte", label: "Svelte" },
  { id: "solid", label: "Solid" },
  { id: "preact", label: "Preact" },
  { id: "astro", label: "Astro" },
  { id: "angular", label: "Angular" },
  { id: "svg", label: "SVG" },
];

const chipClass =
  "inline-flex flex-none items-center gap-1 rounded-full border border-border px-2.5 py-1 text-xs text-foreground no-underline transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent";

// The vadivam "search" and "x" icons used as affordances in the search field.
// Their stroke follows `currentColor`, so the wrapper's text color styles them.
const searchIconSvg = iconsByName.search?.svg ?? "";
const clearIconSvg = iconsByName.x?.svg ?? "";

// Pre-highlight each framework snippet once, with a placeholder component name
// the drawer swaps for the real one on the client. One highlighted template per
// framework (instead of per icon) keeps the page light while the snippet picks
// up the same Shiki theme as the icon detail pages.
const SNIPPET_PLACEHOLDER = "VadivamIcon";
const snippetTemplate = (tab: string, name: string): { lang: string; code: string } | null => {
  switch (tab) {
    case "react":
      return { lang: "tsx", code: `import { ${name} } from "vadivam-react";\n\n<${name} />` };
    case "solid":
      return { lang: "tsx", code: `import { ${name} } from "vadivam-solid";\n\n<${name} />` };
    case "preact":
      return { lang: "tsx", code: `import { ${name} } from "vadivam-preact";\n\n<${name} />` };
    case "vue":
      return {
        lang: "vue",
        code: `<script setup>\nimport { ${name} } from "vadivam-vue";\n<\/script>\n\n<template>\n  <${name} />\n</template>`,
      };
    case "svelte":
      return { lang: "svelte", code: `<script>\n  import { ${name} } from "vadivam-svelte";\n<\/script>\n\n<${name} />` };
    case "astro":
      return { lang: "astro", code: `---\nimport { ${name} } from "vadivam-astro";\n---\n\n<${name} />` };
    case "angular":
      return { lang: "ts", code: `import { ${name} } from "vadivam-angular";\n\n<svg vadivam${name}></svg>` };
    default:
      return null;
  }
};

const highlightThemes = config.codeThemes;
const tabSnippets: Record<string, string> = {};
for (const tab of codeTabs) {
  const template = snippetTemplate(tab.id, SNIPPET_PLACEHOLDER);
  if (template) {
    tabSnippets[tab.id] = await highlightCode(template.code, template.lang, {
      icons: false,
      themes: highlightThemes,
    });
  }
}

// The SVG tab shows raw markup. Every icon shares one normalized wrapper and only
// its `<path d="…">` values differ, so highlight one shell per path-count and let
// the client substitute the real path data.
const svgPathCounts = [...new Set(icons.map((icon) => (icon.svg.match(/ d="/g) ?? []).length))]
  .filter((count) => count > 0)
  .sort((a, b) => a - b);
const svgSnippets: Record<number, string> = {};
for (const count of svgPathCounts) {
  // Match the manifest's exact markup (all paths on one line, no indent) so the
  // highlighted view is identical to what the "Copy SVG" action yields.
  const paths = Array.from({ length: count }, (_, index) => `<path d="__D${index + 1}__"/>`).join("");
  const shell = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">\n${paths}\n</svg>`;
  svgSnippets[count] = await highlightCode(shell, "html", { icons: false, themes: highlightThemes });
}

// Serialize for the inline island. `</` is escaped so no substring can close the
// surrounding <script> tag early; JSON's `\/` decodes back on parse.
const highlightedSnippets = JSON.stringify({
  placeholder: SNIPPET_PLACEHOLDER,
  tabs: tabSnippets,
  svg: svgSnippets,
}).replaceAll("</", "<\\/");

// PageLayout's built-in JSON-LD is disabled so this page can declare the site
// identity plus the library's software entity in one graph.
const site = config.site?.replace(/\/$/, "");
const structuredData = site
  ? {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": `${site}#website`,
          name: config.title,
          url: `${site}/`,
          description: config.description,
        },
        {
          "@type": "SoftwareApplication",
          "@id": `${site}#software`,
          name: config.title,
          url: `${site}/`,
          description: config.description,
          applicationCategory: "DesignApplication",
          operatingSystem: "Any",
          softwareVersion: pkg.version,
          author: { "@type": "Person", name: "Praveen Juge", url: "https://github.com/praveenjuge" },
          license: "https://github.com/praveenjuge/vadivam/blob/main/LICENSE",
          screenshot: `${site}/preview.png`,
          offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
        },
      ],
    }
  : null;
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  favicon={config.favicon}
  appleIcon={config.appleIcon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  x={config.x}
  structuredDataEnabled={false}
  page={{ title: "Vadivam — 24px outline icons", description: config.description }}
>
  <main id="iconExplorer" class="w-full px-4 pt-3 pb-8 md:px-6">
    <header class="pb-4">
      <h1 class="m-0 text-[clamp(1.375rem,2vw,1.75rem)] font-semibold leading-none tracking-[-0.03em]">
        Icons shaped for interfaces.
      </h1>
      <p class="mt-2 mb-0 text-sm text-muted-foreground">
        A free, open-source icon set made for designers and developers building thoughtful digital experiences.
      </p>
    </header>

    <nav class="flex flex-wrap gap-1.5 pb-4" aria-label="Project links">
      {
        links.map((link) => (
          <a class={chipClass} href={link.href} target="_blank" rel="noreferrer" title={link.title}>
            {link.icon ? (
              <span class="inline-flex size-3.5 items-center justify-center [&>svg]:size-3.5" set:html={link.icon} />
            ) : (
              <span class="inline-flex size-3.5 items-center justify-center">
                <img
                  class:list={["size-3.5 object-contain", link.darkIconSrc && "dark:hidden"]}
                  src={link.iconSrc}
                  width="14"
                  height="14"
                  alt=""
                  aria-hidden="true"
                />
                {link.darkIconSrc && (
                  <img
                    class="hidden size-3.5 object-contain dark:block"
                    src={link.darkIconSrc}
                    width="14"
                    height="14"
                    alt=""
                    aria-hidden="true"
                  />
                )}
              </span>
            )}
            <span>{link.label}</span>
          </a>
        ))
      }
    </nav>

    <section aria-label="Icon library">
      <div class="pb-3">
        <div class="relative">
          <span
            class="pointer-events-none absolute inset-y-0 start-0 grid w-10 place-items-center text-muted-foreground [&>svg]:size-4"
            aria-hidden="true"
            set:html={searchIconSvg}
          />
          <input
            class="w-full rounded-full border border-border bg-transparent py-2 ps-10 pe-10 text-base text-foreground outline-none placeholder:text-muted-foreground focus:border-accent focus-visible:outline-none md:text-sm [&::-webkit-search-cancel-button]:hidden [&::-webkit-search-decoration]:hidden"
            id="iconSearch"
            type="search"
            placeholder="Search icons…"
            aria-label="Search icons"
            autocomplete="off"
            spellcheck="false"
          />
          <button
            class="absolute inset-y-0 end-0 grid w-10 place-items-center rounded-full border-0 bg-transparent p-0 text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-inset [&>svg]:size-4"
            id="iconSearchClear"
            type="button"
            aria-label="Clear search"
            hidden
            set:html={clearIconSvg}
          />
        </div>
      </div>

      <div class="grid grid-cols-5 sm:grid-cols-8 md:grid-cols-10 lg:grid-cols-24" id="iconGrid">
        {
          icons.map((icon) => (
            <a
              class="icon-card group relative grid aspect-square min-w-0 cursor-pointer place-items-center rounded-md text-foreground no-underline hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent [&>span]:absolute [&>span]:inset-0 [&>span]:grid [&>span]:cursor-pointer [&>span]:place-items-center aria-[current=true]:bg-accent/10 aria-[current=true]:text-accent aria-[current=true]:ring-1 aria-[current=true]:ring-accent"
              href={`/icons/${icon.name}`}
              data-name={icon.name}
              data-component={icon.componentName}
              data-svg={icon.svg}
              aria-label={`View ${icon.componentName} icon`}
            >
              <Tooltip tip={icon.name}>
                <span class="grid place-items-center [&>svg]:size-6" aria-hidden="true" set:html={icon.svg} />
              </Tooltip>
            </a>
          ))
        }
      </div>

      <p class="py-12 text-center text-sm text-muted-foreground" id="emptyState" hidden>No icons match that search.</p>
    </section>
  </main>

  <aside
    class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-border bg-background/95 text-foreground shadow-[0_-12px_40px_rgb(0_0_0/0.1)] backdrop-blur-lg transition-transform duration-200 ease-out data-[open]:translate-y-0 motion-reduce:transition-none"
    id="iconDrawer"
    aria-labelledby="drawerName"
    aria-hidden="true"
  >
    <div class="flex max-h-[70dvh] w-full flex-col gap-2.5 overflow-y-auto px-4 py-2.5 md:px-6">
      <div class="flex items-center gap-3">
        <div class="grid size-9 flex-none place-items-center rounded-md bg-accent/10 text-accent [&>svg]:size-5" id="drawerPreview" aria-hidden="true"></div>
        <div class="mr-auto grid min-w-0 gap-0.5">
          <div class="flex items-center gap-1">
            <h2 class="m-0 truncate text-sm font-semibold leading-tight" id="drawerName"></h2>
            <button
              class="grid size-5 flex-none place-items-center rounded border-0 bg-transparent p-0 text-muted-foreground transition-colors hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
              type="button"
              data-action="copy-name"
              aria-label="Copy icon name"
            ><Icon icon="copy" size={13} /></button>
          </div>
          <div class="flex items-center gap-1">
            <p class="m-0 truncate font-mono text-xs text-muted-foreground" id="drawerComponent"></p>
            <button
              class="grid size-5 flex-none place-items-center rounded border-0 bg-transparent p-0 text-muted-foreground transition-colors hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
              type="button"
              data-action="copy-component"
              aria-label="Copy component name"
            ><Icon icon="copy" size={13} /></button>
          </div>
        </div>
        <button
          class="grid size-7 flex-none place-items-center rounded-md border-0 bg-transparent p-0 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          id="drawerClose"
          type="button"
          aria-label="Close"
        ><Icon icon="x" size={18} /></button>
      </div>

      <div class="flex gap-1 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" role="tablist" aria-label="Framework snippet">
        {
          codeTabs.map((tab, index) => (
            <button
              class="flex-none rounded-md border border-transparent px-2 py-1 text-xs text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent aria-selected:border-accent aria-selected:bg-accent aria-selected:text-accent-foreground"
              type="button"
              role="tab"
              data-tab={tab.id}
              aria-selected={index === 0 ? "true" : "false"}
            >
              {tab.label}
            </button>
          ))
        }
      </div>

      <div class="relative min-w-0">
        <div class="prose max-w-none" id="drawerCode"></div>
        <button
          class="absolute end-1.5 top-1.5 inline-flex items-center gap-1 rounded-md border border-border bg-background px-2 py-0.5 text-[0.68rem] transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          type="button"
          data-action="copy-code"
          id="drawerCopyCode"
        ><Icon icon="copy" size={12} /><span>Copy</span></button>
      </div>

      <div class="flex flex-wrap items-center gap-1.5">
        <button
          class="inline-flex items-center gap-1.5 rounded-md border border-border bg-transparent px-2.5 py-1.5 text-xs transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          type="button"
          data-action="download"
        ><Icon icon="download" size={14} /><span>Download SVG</span></button>
        <button
          class="inline-flex items-center gap-1.5 rounded-md border border-border bg-transparent px-2.5 py-1.5 text-xs transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          type="button"
          data-action="copy-svg"
        ><Icon icon="code" size={14} /><span>Copy SVG</span></button>
        <a
          class="ml-auto inline-flex items-center gap-1.5 rounded-md border border-border px-2.5 py-1.5 text-xs text-foreground no-underline transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          id="drawerOpenPage"
          href="#"
        ><span>Open page</span><Icon icon="arrow-up-right" size={14} /></a>
      </div>
      <p class="sr-only" id="drawerStatus" aria-live="polite"></p>
    </div>
  </aside>

  <footer slot="footer" class="mx-auto w-full max-w-2xl px-4 pb-10 md:px-6">
    <GithubInfo />
  </footer>

  {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}

  <script is:inline type="application/json" id="snippetHighlight" set:html={highlightedSnippets}></script>

  <script>
    const explorer = document.querySelector<HTMLElement>("#iconExplorer");
    const search = document.querySelector<HTMLInputElement>("#iconSearch");
    const searchClear = document.querySelector<HTMLButtonElement>("#iconSearchClear");
    const grid = document.querySelector<HTMLElement>("#iconGrid");
    const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>(".icon-card"));
    const emptyState = document.querySelector<HTMLElement>("#emptyState");
    const drawer = document.querySelector<HTMLElement>("#iconDrawer");
    const drawerPreview = document.querySelector<HTMLElement>("#drawerPreview");
    const drawerName = document.querySelector<HTMLElement>("#drawerName");
    const drawerComponent = document.querySelector<HTMLElement>("#drawerComponent");
    const drawerStatus = document.querySelector<HTMLElement>("#drawerStatus");
    const drawerClose = document.querySelector<HTMLButtonElement>("#drawerClose");
    const drawerCode = document.querySelector<HTMLElement>("#drawerCode");
    const drawerOpenPage = document.querySelector<HTMLAnchorElement>("#drawerOpenPage");
    const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[role="tab"]'));

    let selected: HTMLAnchorElement | null = null;
    let activeTab = "react";
    let statusTimer: ReturnType<typeof setTimeout> | undefined;

    const getData = () => ({
      name: selected?.dataset.name ?? "",
      component: selected?.dataset.component ?? "",
      svg: selected?.dataset.svg ?? "",
    });

    // Plain-text snippet, used for the copy-to-clipboard action.
    const snippet = (tab: string, component: string, svg: string) => {
      switch (tab) {
        case "react":
          return `import { ${component} } from "vadivam-react";\n\n<${component} />`;
        case "solid":
          return `import { ${component} } from "vadivam-solid";\n\n<${component} />`;
        case "preact":
          return `import { ${component} } from "vadivam-preact";\n\n<${component} />`;
        case "vue":
          return `<script setup>\nimport { ${component} } from "vadivam-vue";\n<\/script>\n\n<template>\n  <${component} />\n</template>`;
        case "svelte":
          return `<script>\n  import { ${component} } from "vadivam-svelte";\n<\/script>\n\n<${component} />`;
        case "astro":
          return `---\nimport { ${component} } from "vadivam-astro";\n---\n\n<${component} />`;
        case "angular":
          return `import { ${component} } from "vadivam-angular";\n\n<svg vadivam${component}></svg>`;
        default:
          return svg;
      }
    };

    // Shiki-highlighted templates rendered at build time (see the page frontmatter).
    // Framework tabs carry a placeholder component name; the SVG tab is keyed by
    // path-count with `__Dn__` placeholders. Both are swapped for the selected
    // icon's real values here so the markup stays a single lightweight template.
    const highlightData: {
      placeholder: string;
      tabs: Record<string, string>;
      svg: Record<string, string>;
    } = (() => {
      const raw = document.getElementById("snippetHighlight")?.textContent;
      try {
        return raw ? JSON.parse(raw) : { placeholder: "", tabs: {}, svg: {} };
      } catch {
        return { placeholder: "", tabs: {}, svg: {} };
      }
    })();

    const escapeHtml = (value: string) =>
      value.replace(/[&<>]/g, (char) => (char === "&" ? "&amp;" : char === "<" ? "&lt;" : "&gt;"));

    const highlightedSnippet = (tab: string, component: string, svg: string) => {
      if (tab === "svg") {
        const paths = Array.from(svg.matchAll(/ d="([^"]*)"/g), (match) => match[1]);
        const template = highlightData.svg[String(paths.length)];
        if (!template) return `<pre class="astro-code"><code>${escapeHtml(svg)}</code></pre>`;
        return paths.reduce((html, d, index) => html.split(`__D${index + 1}__`).join(d), template);
      }
      const template = highlightData.tabs[tab];
      if (!template) return `<pre class="astro-code"><code>${escapeHtml(snippet(tab, component, svg))}</code></pre>`;
      return template.split(highlightData.placeholder).join(component);
    };

    const setStatus = (message: string) => {
      if (!drawerStatus) return;
      drawerStatus.textContent = message;
      clearTimeout(statusTimer);
      statusTimer = setTimeout(() => {
        if (drawerStatus) drawerStatus.textContent = "";
      }, 2000);
    };

    const copy = (value: string, message: string) => {
      navigator.clipboard.writeText(value).then(() => setStatus(message));
    };

    const renderCode = () => {
      if (!drawerCode || !selected) return;
      const { component, svg } = getData();
      drawerCode.innerHTML = highlightedSnippet(activeTab, component, svg);
    };

    const syncClearance = () => {
      if (!drawer) return;
      const open = drawer.hasAttribute("data-open");
      const height = open ? drawer.getBoundingClientRect().height : 0;
      explorer?.style.setProperty("padding-bottom", open ? `${height + 24}px` : "");
    };

    const openDrawer = (card: HTMLAnchorElement) => {
      if (!drawer) return;

      for (const item of cards) item.setAttribute("aria-current", String(item === card));
      selected = card;

      const { name, component, svg } = getData();
      if (drawerPreview) drawerPreview.innerHTML = svg;
      if (drawerName) drawerName.textContent = name;
      if (drawerComponent) drawerComponent.textContent = component;
      if (drawerOpenPage) drawerOpenPage.href = `/icons/${name}/`;

      renderCode();

      drawer.hidden = false;
      drawer.setAttribute("data-open", "");
      drawer.setAttribute("aria-hidden", "false");
      requestAnimationFrame(syncClearance);
    };

    const closeDrawer = () => {
      if (!drawer) return;
      drawer.removeAttribute("data-open");
      drawer.setAttribute("aria-hidden", "true");
      for (const item of cards) item.setAttribute("aria-current", "false");
      selected = null;
      syncClearance();
    };

    const applyFilter = (raw: string) => {
      const query = raw.trim().toLowerCase();
      for (const card of cards) {
        const name = card.dataset.name?.toLowerCase() ?? "";
        const component = card.dataset.component?.toLowerCase() ?? "";
        card.hidden = !(name.includes(query) || component.includes(query));
      }
      if (emptyState) emptyState.hidden = cards.some((card) => !card.hidden);
    };

    const syncSearchUrl = (value: string) => {
      const url = new URL(window.location.href);
      const trimmed = value.trim();
      if (trimmed) url.searchParams.set("q", trimmed);
      else url.searchParams.delete("q");
      history.replaceState(null, "", url);
    };

    const syncClearButton = () => {
      if (!searchClear || !search) return;
      searchClear.hidden = search.value.length === 0;
    };

    search?.addEventListener("input", () => {
      applyFilter(search.value);
      syncSearchUrl(search.value);
      syncClearButton();
    });

    searchClear?.addEventListener("click", () => {
      if (!search) return;
      search.value = "";
      applyFilter("");
      syncSearchUrl("");
      syncClearButton();
      search.focus();
    });

    // Deep-link: `/?q=term` pre-fills and filters.
    const initialQuery = new URLSearchParams(window.location.search).get("q");
    if (initialQuery && search) {
      search.value = initialQuery;
      applyFilter(initialQuery);
    }
    syncClearButton();


    grid?.addEventListener("click", (event) => {
      const mouse = event as MouseEvent;
      // Let modified clicks (new tab/window) and non-primary buttons follow the
      // real /icons/<name> link; only plain left-click opens the drawer.
      if (mouse.metaKey || mouse.ctrlKey || mouse.shiftKey || mouse.altKey || mouse.button !== 0) {
        return;
      }
      const card = (event.target as HTMLElement).closest<HTMLAnchorElement>(".icon-card");
      if (!card) return;
      event.preventDefault();
      openDrawer(card);
    });

    for (const tab of tabButtons) {
      tab.addEventListener("click", () => {
        activeTab = tab.dataset.tab ?? "react";
        for (const button of tabButtons) {
          button.setAttribute("aria-selected", String(button === tab));
        }
        renderCode();
        requestAnimationFrame(syncClearance);
      });
    }

    drawerClose?.addEventListener("click", closeDrawer);

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeDrawer();
    });

    window.addEventListener("resize", syncClearance);

    drawer?.addEventListener("click", (event) => {
      const action = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-action]");
      if (!action || !selected) return;

      const { name, component, svg } = getData();

      switch (action.dataset.action) {
        case "download": {
          const blob = new Blob([svg], { type: "image/svg+xml" });
          const url = URL.createObjectURL(blob);
          const link = document.createElement("a");
          link.href = url;
          link.download = `${name}.svg`;
          link.click();
          URL.revokeObjectURL(url);
          setStatus(`Downloaded ${name}.svg`);
          break;
        }
        case "copy-code":
          copy(snippet(activeTab, component, svg), "Snippet copied.");
          break;
        case "copy-svg":
          copy(svg, "SVG copied.");
          break;
        case "copy-name":
          copy(name, "Name copied.");
          break;
        case "copy-component":
          copy(component, "Component name copied.");
          break;
      }
    });
  </script>
</PageLayout>

<style is:global>
  html,
  body {
    overflow-x: clip;
  }

  /* Compact the Shiki-highlighted drawer snippet. The ID selector outranks the
     shared `.prose` code rules for layout while leaving the theme's colors and
     transparent background (set with !important) untouched. Blume keeps the code
     block's horizontal padding on the inner `code` (so long lines scroll past a
     static pre), so the pre carries only vertical padding — adding horizontal
     padding here too would double the left inset. */
  #drawerCode.prose pre.astro-code {
    margin: 0;
    max-height: 8rem;
    min-height: 4.5rem;
    overflow-y: auto;
    padding: 0.5rem 0;
    font-size: 0.72rem;
    line-height: 1.5;
    scrollbar-width: thin;
  }

  #drawerCode.prose pre.astro-code > code {
    padding: 0 0.75rem;
  }
</style>
