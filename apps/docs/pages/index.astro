---
import PageLayout from "blume/components/layout/PageLayout.astro";
import GithubInfo from "blume/components/content/GithubInfo.astro";
import data from "blume:data";
import { categories, icons, iconsByName } from "vadivam/manifest";
import { iconLastmods } from "../../../scripts/icon-lastmods.mjs";
import { frameworks } from "../../../scripts/snippets.mjs";
import pkg from "../../../package.json";
import ActionMenus from "./_lib/ActionMenus.astro";
import Customizer from "./_lib/Customizer.astro";
import VIcon from "./_lib/VIcon.astro";
import { agentPrompt } from "./_lib/agent-prompt";
import IconSketch from "./_lib/IconSketch.astro";
import { SVG_OPEN_TAG, buildSnippetTemplates, serializeForScript } from "./_lib/snippet-templates";

const { config } = data;


const codeTabs = [...frameworks.map(({ id, label }) => ({ id, label })), { id: "svg", label: "SVG" }];
// The hero's sentence names every package and tool, each with its mark.
type HeroLink = { label: string; href: string; logo?: string; logoClass?: string; icon?: "file-code" | "bot"; external?: boolean };
const packageLinks: HeroLink[] = [
  ...frameworks.map(({ id, label }) => ({ label, href: `/docs/${id}`, logo: id === "react-native" ? "react" : id })),
  { label: "SVG", href: "/docs/core", icon: "file-code" },
];
const toolLinks: HeroLink[] = [
  { label: "shadcn/ui", href: "/docs/shadcn", logo: "shadcn", logoClass: "dark:invert" },
  { label: "MCP", href: "/docs/mcp", icon: "bot" },
  { label: "Iconify", href: "https://icon-sets.iconify.design/vadivam/", logo: "iconify", external: true },
  { label: "Figma", href: "https://www.figma.com/community/plugin/1661323620355050204/vadivam-icons", logo: "figma", external: true },
];
const logoClass = "me-1 inline-block size-3.5 align-[-0.15em] object-contain";
const inlineLinkClass =
  "whitespace-nowrap text-foreground no-underline decoration-border underline-offset-4 transition-colors hover:underline hover:decoration-current focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent";
const iconButtonClass =
  "grid size-7 flex-none place-items-center rounded-md border-0 bg-transparent p-0 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent disabled:opacity-40 disabled:hover:bg-transparent";
const smallCopyClass =
  "grid size-5 flex-none place-items-center rounded border-0 bg-transparent p-0 text-muted-foreground transition-colors hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent";

// The vadivam "search" and "x" icons used as affordances in the search field.
// Their stroke follows `currentColor`, so the wrapper's text color styles them.
const searchIconSvg = iconsByName.search?.svg ?? "";
const clearIconSvg = iconsByName.x?.svg ?? "";

// Category filter options, largest first after "All".
const categoryCounts = new Map<string, number>();
for (const icon of icons) {
  for (const id of icon.categories) categoryCounts.set(id, (categoryCounts.get(id) ?? 0) + 1);
}
const categoryOptions = [...categories].sort((left, right) => left.title.localeCompare(right.title));

// Tiles carry only their path data; size, stroke, and caps come from CSS, and
// the client rebuilds each icon's SVG from these paths. Fail the build if that
// would not reproduce the manifest exactly.
const tilePaths = new Map<string, string>();
for (const icon of icons) {
  const paths = Array.from(icon.svg.matchAll(/ d="([^"]*)"/g), (match) => `<path d="${match[1]}"/>`).join("");
  if (`${SVG_OPEN_TAG}\n${paths}\n</svg>\n` !== icon.svg) {
    throw new Error(`${icon.name}.svg can't be rebuilt from its paths`);
  }
  tilePaths.set(icon.name, paths);
}

// Search placeholder examples, cycled until the visitor types. Fail the build
// if one is renamed or removed.
const searchExamples = ["coffee", "rocket", "cat", "calendar", "heart", "cloud", "settings", "palette"];
for (const name of searchExamples) {
  if (!tilePaths.has(name)) throw new Error(`Search example "${name}" is not in the set`);
}
const iconCount = icons.length.toLocaleString("en-US");

// 120 divides every column count the grid uses (5, 8, 10, 24), so chunks
// stack without ragged rows. See `.icon-chunk`.
const chunkSize = 120;
const chunks = Array.from({ length: Math.ceil(icons.length / chunkSize) }, (_, index) =>
  icons.slice(index * chunkSize, (index + 1) * chunkSize),
);

const pathCounts = [...new Set(icons.map((icon) => (icon.svg.match(/ d="/g) ?? []).length))].filter((count) => count > 0);
const snippetTemplates = serializeForScript(await buildSnippetTemplates(config.codeThemes, pathCounts));

// PageLayout's built-in JSON-LD is disabled so this page can declare the site
// identity plus the library's software entity in one graph.
const site = config.site?.replace(/\/$/, "");
// The catalog changes when an icon does, so date the page by its newest icon.
const lastModified = [...iconLastmods().values()].sort().at(-1);
const structuredData = site
  ? {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": `${site}#website`,
          name: config.title,
          url: `${site}/`,
          description: config.description,
        },
        {
          "@type": "WebPage",
          "@id": `${site}/#page`,
          name: "Vadivam — 24px outline icons",
          url: `${site}/`,
          description: config.description,
          inLanguage: "en",
          isPartOf: { "@id": `${site}#website` },
          about: { "@id": `${site}#software` },
          ...(lastModified && { dateModified: lastModified }),
        },
        {
          "@type": "SoftwareApplication",
          "@id": `${site}#software`,
          name: config.title,
          url: `${site}/`,
          description: config.description,
          applicationCategory: "DesignApplication",
          operatingSystem: "Any",
          softwareVersion: pkg.version,
          author: { "@type": "Person", name: "Praveen Juge", url: "https://github.com/praveenjuge" },
          license: "https://github.com/praveenjuge/vadivam/blob/main/LICENSE",
          screenshot: `${site}/preview.png`,
          offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
        },
      ],
    }
  : null;
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  favicon={config.favicon}
  appleIcon={config.appleIcon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  x={config.x}
  structuredDataEnabled={false}
  page={{ title: "Vadivam — 24px outline icons", description: config.description }}
>
  {/* Keep the JSON-LD at the top of the body: the icon grid below inlines
      roughly 1 MB of SVG, and crawlers that truncate the response would
      otherwise never reach a script placed after it. */}
  {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}

  <main id="iconExplorer" class="w-full px-4 pb-8 md:px-6">
    <header class="grid gap-x-10 gap-y-5 pt-6 pb-6 md:grid-cols-[minmax(0,1fr)_auto] md:items-center">
      <div class="grid min-w-0 gap-2.5">
        <p class="m-0 flex flex-wrap gap-x-3 gap-y-1 font-mono text-[0.7rem] uppercase tracking-[0.08em] text-muted-foreground">
          <span>{iconCount} icons</span>
          <span aria-hidden="true">·</span>
          <span>24px grid</span>
          <span aria-hidden="true">·</span>
          <span>2px stroke</span>
          <span aria-hidden="true">·</span>
          <span>MIT</span>
        </p>
        <h1 class="m-0 text-balance text-[clamp(1.625rem,3vw,2.25rem)] font-semibold leading-[1.1] tracking-[-0.03em]">
          Icons shaped for interfaces.
        </h1>
        <p class="m-0 max-w-[62rem] text-sm leading-relaxed text-muted-foreground">
          <em class="text-foreground">Vadivam</em> (<span lang="ta">வடிவம்</span>) is Tamil for “shape.” Free, open-source icons for{" "}
          {packageLinks.map((link, index) => (
            <Fragment>
              {index > 0 && (index === packageLinks.length - 1 ? ", and " : ", ")}
              <a class={inlineLinkClass} href={link.href}>
                {link.logo ? <img class:list={[logoClass, link.logoClass]} src={`/frameworks/${link.logo}.svg`} width="14" height="14" alt="" /> : <VIcon name={link.icon!} size={14} class="me-1 align-[-0.15em]" />}{link.label}
              </a>
            </Fragment>
          ))}, with{" "}
          {toolLinks.map((link, index) => (
            <Fragment>
              {index > 0 && (index === toolLinks.length - 1 ? ", and " : ", ")}
              <a class={inlineLinkClass} href={link.href} {...(link.external && { target: "_blank", rel: "noreferrer" })}>
                {link.logo ? <img class:list={[logoClass, link.logoClass]} src={`/frameworks/${link.logo}.svg`} width="14" height="14" alt="" /> : <VIcon name={link.icon!} size={14} class="me-1 align-[-0.15em]" />}{link.label}
              </a>
            </Fragment>
          ))}.
        </p>
        <div class="pt-1">
          <button
            class="group inline-flex h-8 items-center gap-1.5 rounded-lg border-0 bg-foreground px-3 text-[0.8125rem] font-medium text-background shadow-sm transition-opacity hover:opacity-85 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background"
            type="button"
            id="agentPromptCopy"
          >
            <span class="flex group-data-[state]:hidden"><VIcon name="sparkles" size={14} /></span>
            <span class="hidden group-data-[state=copied]:flex"><VIcon name="check" size={14} /></span>
            <span class="hidden group-data-[state=failed]:flex"><VIcon name="x" size={14} /></span>
            <span class="group-data-[state]:hidden">Copy prompt for AI agents</span>
            <span class="hidden group-data-[state=copied]:inline">Copied. Paste it into your agent</span>
            <span class="hidden group-data-[state=failed]:inline">Your browser blocked copying. Copy it from below</span>
            <span class="flex transition-transform group-hover:translate-x-0.5 group-data-[state]:hidden"><VIcon name="arrow-right" size={13} /></span>
          </button>
          <span class="sr-only" id="agentPromptStatus" aria-live="polite"></span>
          {/* Shown, with its text selected, only when the browser refuses the clipboard. */}
          <textarea
            class="mt-3 block h-40 w-full max-w-[62rem] resize-y rounded-lg border border-border bg-muted/40 p-3 font-mono text-[0.75rem] leading-relaxed text-foreground outline-none focus:border-accent"
            id="agentPromptText"
            aria-label="Prompt for AI agents"
            readonly
            hidden
          >{agentPrompt}</textarea>
        </div>
      </div>
      <div class="hidden size-36 md:block lg:size-40">
        <IconSketch />
      </div>
    </header>

    <section aria-label="Icon library">
      {/* Sticky under Blume's 4rem header, so search stays at hand while browsing. */}
      <div class="sticky top-16 z-30 -mx-4 flex items-center gap-2 border-b border-border bg-background/95 px-4 py-2.5 backdrop-blur md:-mx-6 md:px-6">
        <div class="relative min-w-0 flex-1">
          <span
            class="pointer-events-none absolute inset-y-0 start-0 grid w-10 place-items-center text-muted-foreground [&>svg]:size-4"
            aria-hidden="true"
            set:html={searchIconSvg}
          />
          <input
            class="peer w-full rounded-lg border border-border bg-background py-2 ps-10 pe-3 text-base text-foreground outline-none placeholder:text-muted-foreground md:pe-12 [&:not(:placeholder-shown)]:pe-10 focus:border-accent focus-visible:outline-none md:text-sm [&::-webkit-search-cancel-button]:hidden [&::-webkit-search-decoration]:hidden"
            id="iconSearch"
            type="search"
            placeholder={`Search ${iconCount} icons`}
            aria-label="Search icons"
            data-examples={searchExamples.join(" ")}
            aria-describedby="resultCount"
            aria-keyshortcuts="/"
            autocomplete="off"
            spellcheck="false"
          />
          <kbd class="pointer-events-none absolute end-3 top-1/2 hidden -translate-y-1/2 rounded border border-border px-1.5 font-mono text-[0.65rem] leading-4 text-muted-foreground peer-focus:hidden peer-[:not(:placeholder-shown)]:hidden md:block" aria-hidden="true">/</kbd>
          <button
            class="absolute inset-y-0 end-0 grid w-10 place-items-center rounded-lg border-0 bg-transparent p-0 text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-inset [&>svg]:size-4"
            id="iconSearchClear"
            type="button"
            aria-label="Clear search"
            hidden
            set:html={clearIconSvg}
          />
        </div>
        <span class="relative flex w-[7.5rem] flex-none sm:w-auto">
          <select
            class="w-full cursor-pointer appearance-none rounded-lg border border-border bg-background py-2 ps-3 pe-9 text-base text-foreground outline-none focus:border-accent md:text-sm"
            id="iconCategory"
            aria-label="Filter by category"
          >
            <option value="">All</option>
            {categoryOptions.map((category) => (
              <option value={category.id}>{category.title} ({categoryCounts.get(category.id) ?? 0})</option>
            ))}
          </select>
          <VIcon name="chevron-down" size={16} class="pointer-events-none absolute inset-y-0 end-3 items-center text-muted-foreground" />
        </span>
        <p class="sr-only m-0 flex-none text-xs tabular-nums text-muted-foreground lg:not-sr-only" id="resultCount" aria-live="polite">{icons.length} icons</p>
      </div>

      <div class="icon-browser pt-3" id="iconBrowser">
        <div class="icon-grid" id="iconGrid">
          {
            chunks.map((chunk) => (
              <div class="icon-chunk">
                {chunk.map((icon) => (
                  <a href={`/icons/${icon.name}`} aria-label={icon.name}><svg viewBox="0 0 24 24" set:html={tilePaths.get(icon.name)} /></a>
                ))}
              </div>
            ))
          }
        </div>
        <div id="iconResults" aria-label="Search results" hidden></div>
      </div>
      <div
        class="pointer-events-none fixed z-50 w-max rounded-blume border border-border bg-background px-3 py-2 font-sans text-sm leading-5 text-muted-foreground shadow-lg"
        id="iconTooltip"
        role="tooltip"
        hidden
      ></div>

      <div class="grid justify-items-center gap-3 py-16 text-center" id="emptyState" hidden>
        <p class="m-0 text-sm text-foreground">No icons match <span id="emptyQuery"></span>.</p>
        <p class="m-0 max-w-[40ch] text-xs text-muted-foreground">Try a broader word or another category. Missing something? Request it on GitHub.</p>
        <div class="flex flex-wrap justify-center gap-2">
          <button class="rounded-md border border-border bg-background px-3 py-1.5 text-xs text-foreground transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent" type="button" id="emptyReset">Clear filters</button>
          <a class="rounded-md border border-border px-3 py-1.5 text-xs text-foreground no-underline transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent" href="https://github.com/praveenjuge/vadivam/issues/new" target="_blank" rel="noreferrer">Request an icon</a>
        </div>
      </div>
    </section>
  </main>

  <aside
    class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-border bg-background text-foreground shadow-[0_-12px_40px_rgb(0_0_0/0.1)] transition-transform duration-200 ease-out data-[open]:translate-y-0 motion-reduce:transition-none"
    id="iconDrawer"
    aria-labelledby="drawerName"
    inert
  >
    <div class="flex max-h-[min(85dvh,30rem)] w-full flex-col">
      <div class="grid touch-none place-items-center pt-2 md:hidden" id="drawerHandle" aria-hidden="true">
        <span class="h-1 w-10 rounded-full bg-border"></span>
      </div>

      <header class="flex touch-pan-y items-center gap-3 px-4 py-2.5 md:px-6" id="drawerHeader">
        <div class="grid size-10 flex-none place-items-center rounded-md bg-accent/10 text-accent" data-icon-preview="24" aria-hidden="true"></div>
        <div class="grid min-w-0 flex-1 gap-0.5">
          <div class="flex min-w-0 items-center gap-1">
            <h2 class="m-0 truncate text-sm font-semibold leading-tight outline-none" id="drawerName" tabindex="-1"></h2>
            <button class={smallCopyClass} type="button" data-action="copy-name" aria-label="Copy icon name"><VIcon name="copy" size={13} /></button>
          </div>
          <div class="flex min-w-0 items-center gap-1">
            <p class="m-0 truncate font-mono text-xs text-muted-foreground" id="drawerComponent"></p>
            <button class={smallCopyClass} type="button" data-action="copy-component" aria-label="Copy component name"><VIcon name="copy" size={13} /></button>
          </div>
        </div>
        <div class="flex flex-none items-center gap-0.5">
          <button class={iconButtonClass} type="button" id="drawerPrev" aria-label="Previous icon" aria-keyshortcuts="ArrowLeft"><VIcon name="chevron-left" size={18} /></button>
          <button class={iconButtonClass} type="button" id="drawerNext" aria-label="Next icon" aria-keyshortcuts="ArrowRight"><VIcon name="chevron-right" size={18} /></button>
          <a class:list={[iconButtonClass, "no-underline"]} id="drawerOpenPage" href="#" aria-label="Open icon page"><VIcon name="arrow-up-right" size={18} /></a>
          <button class={iconButtonClass} type="button" id="drawerClose" aria-label="Close" aria-keyshortcuts="Escape"><VIcon name="x" size={18} /></button>
        </div>
      </header>

      <div class="grid min-h-0 flex-1 overflow-y-auto border-t border-border md:grid-cols-[minmax(0,1fr)_17rem] md:overflow-hidden lg:grid-cols-[minmax(0,1fr)_17rem_17rem]">
        <section class="order-2 grid min-w-0 content-start gap-2.5 px-4 py-3 md:order-1 md:overflow-y-auto md:px-6" aria-label="Code">
          <div class="flex gap-1 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" role="tablist" aria-label="Framework snippet">
            {
              codeTabs.map((tab, index) => (
                <button
                  class="flex-none rounded-md border border-transparent px-2 py-1 text-xs text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent aria-selected:border-accent aria-selected:bg-accent aria-selected:text-accent-foreground"
                  type="button"
                  role="tab"
                  data-tab={tab.id}
                  aria-selected={index === 0 ? "true" : "false"}
                  aria-controls="drawerCode"
                >
                  {tab.label}
                </button>
              ))
            }
          </div>
          <div class="relative min-w-0">
            <div class="prose max-w-none" id="drawerCode" role="tabpanel"></div>
            <button
              class="absolute end-1.5 top-1.5 inline-flex items-center gap-1 rounded-md border border-border bg-background px-2 py-0.5 text-[0.68rem] transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
              type="button"
              data-action="copy-code"
            ><VIcon name="copy" size={12} /><span>Copy</span></button>
          </div>
          <dl class="m-0 grid gap-1.5 text-xs" id="drawerMeta">
            <div class="flex flex-wrap items-baseline gap-1.5">
              <dt class="text-muted-foreground">Categories</dt>
              <dd class="m-0 flex flex-wrap gap-1" id="drawerCategories"></dd>
            </div>
            <div class="flex flex-wrap items-baseline gap-1.5">
              <dt class="text-muted-foreground">Tags</dt>
              <dd class="m-0 flex flex-wrap gap-1" id="drawerTags"></dd>
            </div>
          </dl>
        </section>

        <section class="order-1 grid content-start gap-3 border-b border-border px-4 py-3 md:order-2 md:overflow-y-auto md:border-b-0 md:border-l lg:contents" aria-label="Customize and export">
          <div class="grid content-start gap-3 lg:order-2 lg:overflow-y-auto lg:border-l lg:border-border lg:px-4 lg:py-3">
          <div class="flex flex-wrap items-center gap-1.5">
            <button
              class="inline-flex items-center gap-1.5 rounded-md border border-accent bg-accent px-2.5 py-1.5 text-xs text-accent-foreground transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
              type="button"
              data-action="copy-svg"
            ><VIcon name="code" size={14} /><span>Copy SVG</span></button>
            <ActionMenus id="drawerMenu" />
            <span class="text-xs text-muted-foreground" id="drawerStatus" aria-live="polite"></span>
          </div>
          <div class="flex items-end justify-between gap-2 rounded-md border border-border px-3 py-2.5 text-foreground" aria-label="Size previews">
            {[16, 20, 24, 32, 48].map((size) => (
              <div class="grid justify-items-center gap-1">
                <div class="grid place-items-center" data-icon-preview={size}></div>
                <span class="font-mono text-[0.65rem] text-muted-foreground">{size}</span>
              </div>
            ))}
          </div>
          </div>
          <details class="group lg:order-3 lg:overflow-y-auto lg:border-l lg:border-border lg:px-4 lg:py-3" id="drawerCustomize">
            <summary class="flex cursor-pointer list-none items-center justify-between text-xs font-medium text-foreground [&::-webkit-details-marker]:hidden">
              Customize
              <span class="text-muted-foreground transition-transform group-open:rotate-180"><VIcon name="chevron-down" size={14} /></span>
            </summary>
            <Customizer compact class="pt-3" />
          </details>
        </section>
      </div>
    </div>
  </aside>

  <footer slot="footer" class="mx-auto w-full max-w-2xl px-4 pb-10 md:px-6">
    <GithubInfo />
  </footer>

  <script is:inline type="application/json" id="snippetTemplates" set:html={snippetTemplates}></script>
  <script is:inline type="application/json" id="siteVersion" set:html={JSON.stringify(pkg.version)}></script>

  <script>
    import {
      bindCustomizer,
      createSettingsStore,
      readTemplates,
      renderPreviews,
      runAction,
      snippetHtml,
      snippetText,
      copyText,
      wireMenus,
      type IconRef,
    } from "./_lib/icon-tools";
    import { iconDefaults } from "../../../scripts/snippets.mjs";

    // Astro's client router swaps pages without reloading, and a bundled
    // script runs only once, so set the page up on every page load and tear
    // down the window and document listeners before the next swap.
    document.addEventListener("astro:page-load", () => {
      if (!document.querySelector("#iconExplorer")) return;
      const lifecycle = new AbortController();
      const { signal } = lifecycle;
      document.addEventListener("astro:before-swap", () => lifecycle.abort(), { once: true });

      const explorer = document.querySelector<HTMLElement>("#iconExplorer")!;
      const search = document.querySelector<HTMLInputElement>("#iconSearch")!;
      const searchClear = document.querySelector<HTMLButtonElement>("#iconSearchClear")!;
      const categorySelect = document.querySelector<HTMLSelectElement>("#iconCategory")!;
      const resultCount = document.querySelector<HTMLElement>("#resultCount")!;
      const browser = document.querySelector<HTMLElement>("#iconBrowser")!;
      const grid = document.querySelector<HTMLElement>("#iconGrid")!;
      const results = document.querySelector<HTMLElement>("#iconResults")!;
      const emptyState = document.querySelector<HTMLElement>("#emptyState")!;
      const emptyQuery = document.querySelector<HTMLElement>("#emptyQuery")!;
      const tooltip = document.querySelector<HTMLElement>("#iconTooltip")!;
      const drawer = document.querySelector<HTMLElement>("#iconDrawer")!;
      const drawerName = document.querySelector<HTMLElement>("#drawerName")!;
      const drawerComponent = document.querySelector<HTMLElement>("#drawerComponent")!;
      const drawerStatus = document.querySelector<HTMLElement>("#drawerStatus")!;
      const drawerCode = document.querySelector<HTMLElement>("#drawerCode")!;
      const drawerOpenPage = document.querySelector<HTMLAnchorElement>("#drawerOpenPage")!;
      const drawerCategories = document.querySelector<HTMLElement>("#drawerCategories")!;
      const drawerTags = document.querySelector<HTMLElement>("#drawerTags")!;
      const drawerCustomize = document.querySelector<HTMLDetailsElement>("#drawerCustomize")!;
      const tabButtons = Array.from(drawer.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const cards = Array.from(grid.querySelectorAll<HTMLAnchorElement>(".icon-chunk > a"));

      const templates = readTemplates("snippetTemplates");
      const version = JSON.parse(document.getElementById("siteVersion")?.textContent ?? '""');
      const store = createSettingsStore();
      const tabKey = "vadivam:tab";

      // A tile's aria-label is its icon name.
      const nameOf = (card: HTMLElement | null) => card?.getAttribute("aria-label") ?? "";
      const pascalCase = (name: string) =>
        name.split("-").filter(Boolean).map((part) => part.charAt(0).toUpperCase() + part.slice(1)).join("");

      // ---- Search index -------------------------------------------------------
      // Names are in the HTML; tags and categories load on first search intent.
      type Entry = {
        card: HTMLAnchorElement;
        clone?: HTMLAnchorElement;
        name: string;
        words: string;
        /** The name without hyphens, so component names like `ArrowUp` match. */
        compact: string;
        tags: string[];
        categories: string[];
      };
      const entries: Entry[] = cards.map((card) => {
        const name = nameOf(card);
        return { card, name, words: name.replaceAll("-", " "), compact: name.replaceAll("-", ""), tags: [], categories: [] };
      });
      const entryByName = new Map(entries.map((entry) => [entry.name, entry]));
      let categoryTitles: Record<string, string> = {};
      let indexPromise: Promise<void> | null = null;

      const loadIndex = () =>
        (indexPromise ??= fetch("/icons/index.json")
          .then((response) => (response.ok ? response.json() : Promise.reject(new Error(`HTTP ${response.status}`))))
          .then((index: { categories: Record<string, string>; icons: [string, string[], string][] }) => {
            categoryTitles = index.categories;
            for (const [name, tags, categories] of index.icons) {
              const entry = entryByName.get(name);
              if (!entry) continue;
              entry.tags = tags;
              entry.categories = categories ? categories.split(" ") : [];
            }
          })
          .catch(() => {
            // Name search keeps working without the index; retry on next intent.
            indexPromise = null;
          }));

      // Lower rank sorts first: exact name, name prefix, name word, tag, category.
      const termRank = (entry: Entry, term: string) => {
        if (entry.name === term || entry.compact === term) return 0;
        if (entry.name.startsWith(term) || entry.compact.startsWith(term)) return 1;
        if (entry.words.includes(term) || entry.compact.includes(term)) return 2;
        if (entry.tags.some((tag) => tag.startsWith(term))) return 3;
        if (entry.tags.some((tag) => tag.includes(term))) return 4;
        if (entry.categories.some((id) => (categoryTitles[id] ?? id).toLowerCase().includes(term))) return 5;
        return -1;
      };

      const rankEntry = (entry: Entry, terms: string[], category: string) => {
        if (category && !entry.categories.includes(category)) return -1;
        if (terms.length === 0) return 0;
        const joined = terms.join("-");
        if (terms.length > 1 && entry.name.includes(joined)) return entry.name === joined ? 0 : 1;
        let rank = 0;
        for (const term of terms) {
          const termRanked = termRank(entry, term);
          if (termRanked < 0) return -1;
          rank = Math.max(rank, termRanked);
        }
        return rank;
      };

      // Filtering never touches the full grid: it goes dormant (keeping its
      // rendering state) and only the matches render into a results grid. More
      // matches render as the reader scrolls near the end, so a keystroke lays
      // out tens of tiles instead of all of them.
      let matches: Entry[] | null = null;
      let renderedCount = 0;
      const batchSize = 120;
      const sentinel = document.createElement("div");
      sentinel.setAttribute("aria-hidden", "true");

      const cloneOf = (entry: Entry) => {
        if (!entry.clone) {
          entry.clone = entry.card.cloneNode(true) as HTMLAnchorElement;
          entry.clone.setAttribute("aria-current", "false");
        }
        return entry.clone;
      };

      const renderBatch = (size: number) => {
        if (!matches) return;
        // Matches render in chunks of `batchSize`, styled and contained like the
        // full grid's; `.icon-chunk` reserves the height of exactly one batch.
        const end = Math.min(matches.length, renderedCount + size);
        while (renderedCount < end) {
          const chunk = document.createElement("div");
          chunk.className = "icon-chunk";
          const chunkEnd = Math.min(end, renderedCount + batchSize);
          for (; renderedCount < chunkEnd; renderedCount += 1) chunk.append(cloneOf(matches[renderedCount]!));
          results.append(chunk);
        }
        if (renderedCount < matches.length) {
          results.after(sentinel);
          // Re-observing reports the sentinel's current state, so a sentinel
          // that is still in view after this batch asks for the next one.
          sentinelObserver.unobserve(sentinel);
          sentinelObserver.observe(sentinel);
        } else sentinel.remove();
      };

      const sentinelObserver = new IntersectionObserver(
        (observed) => {
          if (observed.some((item) => item.isIntersecting)) renderBatch(batchSize);
        },
        { rootMargin: "800px 0px" },
      );

      // Set by the drawer: keeps its selection on the tile that's on screen.
      let afterFilter = () => {};

      let filterFrame = 0;
      const applyFilter = () => {
        cancelAnimationFrame(filterFrame);
        filterFrame = requestAnimationFrame(() => {
          const terms = search.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
          const category = categorySelect.value;
          if (terms.length === 0 && !category) {
            matches = null;
            results.hidden = true;
            results.replaceChildren();
            sentinel.remove();
            grid.classList.remove("is-dormant");
            emptyState.hidden = true;
            resultCount.textContent = `${entries.length} icons`;
            afterFilter();
            return;
          }
          matches = entries
            .map((entry, index) => ({ entry, index, rank: rankEntry(entry, terms, category) }))
            .filter(({ rank }) => rank >= 0)
            .sort((left, right) => left.rank - right.rank || left.index - right.index)
            .map(({ entry }) => entry);
          grid.classList.add("is-dormant");
          results.replaceChildren();
          renderedCount = 0;
          results.hidden = matches.length === 0;
          renderBatch(batchSize);
          emptyState.hidden = matches.length > 0;
          emptyQuery.textContent = [search.value.trim() && `“${search.value.trim()}”`, category && `in ${categorySelect.selectedOptions[0]?.textContent?.replace(/ \(\d+\)$/, "")}`]
            .filter(Boolean)
            .join(" ");
          resultCount.textContent = `${matches.length} of ${entries.length} icons`;
          afterFilter();
        });
      };

      const syncUrl = () => {
        const url = new URL(location.href);
        const query = search.value.trim();
        if (query) url.searchParams.set("q", query);
        else url.searchParams.delete("q");
        if (categorySelect.value) url.searchParams.set("category", categorySelect.value);
        else url.searchParams.delete("category");
        history.replaceState(history.state, "", url);
      };

      const filterNow = () => {
        searchClear.hidden = search.value.length === 0;
        applyFilter();
        syncUrl();
      };

      for (const eventName of ["focus", "pointerenter"]) {
        search.addEventListener(eventName, loadIndex, { once: true });
        categorySelect.addEventListener(eventName, loadIndex, { once: true });
      }
      search.addEventListener("input", () => {
        filterNow();
        if (search.value) loadIndex()?.then(applyFilter);
      });
      categorySelect.addEventListener("change", () => {
        filterNow();
        loadIndex()?.then(applyFilter);
      });
      searchClear.addEventListener("click", () => {
        search.value = "";
        filterNow();
        search.focus();
      });
      document.querySelector("#emptyReset")?.addEventListener("click", () => {
        search.value = "";
        categorySelect.value = "";
        filterNow();
        search.focus();
      });

      // "/" jumps to icon search from anywhere on this page. Captured on the
      // window so it wins over Blume's "/" docs search; ⌘K still opens that.
      addEventListener(
        "keydown",
        (event) => {
          if (event.key !== "/" || event.altKey || event.metaKey || event.ctrlKey) return;
          if ((event.target as HTMLElement).closest?.("input, select, textarea, [contenteditable], dialog")) return;
          event.preventDefault();
          event.stopPropagation();
          search.focus();
          search.select();
        },
        { capture: true, signal },
      );

      // Deep links: `/?q=term&category=id` pre-fill and filter.
      const initial = new URLSearchParams(location.search);
      search.value = initial.get("q") ?? "";
      if (initial.get("category") && categorySelect.querySelector(`option[value="${CSS.escape(initial.get("category") ?? "")}"]`)) {
        categorySelect.value = initial.get("category") ?? "";
      }
      if (search.value || categorySelect.value) {
        searchClear.hidden = search.value.length === 0;
        applyFilter();
        loadIndex()?.then(applyFilter);
      }

      // ---- Tooltip ------------------------------------------------------------
      // One shared tooltip instead of one per tile keeps the homepage under the
      // 2 MB crawl limit. It stays inside the viewport and Escape hides it (WCAG 1.4.13).
      let tooltipCard: HTMLAnchorElement | null = null;
      const hideTooltip = () => {
        tooltipCard?.removeAttribute("aria-describedby");
        tooltipCard = null;
        tooltip.hidden = true;
      };
      const showTooltip = (card: HTMLAnchorElement) => {
        if (card === tooltipCard) return;
        hideTooltip();
        tooltip.textContent = nameOf(card);
        tooltip.hidden = false;
        const margin = 8;
        const target = card.getBoundingClientRect();
        const { width, height } = tooltip.getBoundingClientRect();
        const maxLeft = document.documentElement.clientWidth - margin - width;
        const above = target.top - height - margin;
        tooltip.style.left = `${Math.max(margin, Math.min(target.left + target.width / 2 - width / 2, maxLeft))}px`;
        tooltip.style.top = `${above >= 0 ? above : target.bottom + margin}px`;
        card.setAttribute("aria-describedby", tooltip.id);
        tooltipCard = card;
      };
      const cardFrom = (event: Event) => (event.target as HTMLElement).closest<HTMLAnchorElement>(".icon-chunk > a");
      browser.addEventListener("pointerover", (event) => {
        // Touch has no hover.
        if ((event as PointerEvent).pointerType === "touch") return;
        const card = cardFrom(event);
        if (card) showTooltip(card);
        else hideTooltip();
      });
      browser.addEventListener("pointerleave", hideTooltip);
      browser.addEventListener("focusin", (event) => {
        const card = cardFrom(event);
        if (card?.matches(":focus-visible")) showTooltip(card);
      });
      browser.addEventListener("focusout", hideTooltip);
      addEventListener("scroll", hideTooltip, { passive: true, signal });

      // ---- Drawer -------------------------------------------------------------
      let selected: HTMLAnchorElement | null = null;
      let activeTab = (() => {
        try {
          return localStorage.getItem(tabKey) ?? "react";
        } catch {
          return "react";
        }
      })();
      if (!tabButtons.some((button) => button.dataset.tab === activeTab)) activeTab = "react";
      let statusTimer: ReturnType<typeof setTimeout> | undefined;

      // Rebuilt from the tile's inline paths; the build checks this matches the manifest.
      const currentIcon = (): IconRef | null => {
        if (!selected || !templates) return null;
        const paths = Array.from(selected.querySelectorAll("path"), (path) => `<path d="${path.getAttribute("d")}"/>`);
        const name = nameOf(selected);
        return { name, component: pascalCase(name), svg: `${templates.svgOpenTag}\n${paths.join("")}\n</svg>\n` };
      };

      const setStatus = (message: string) => {
        drawerStatus.textContent = message;
        clearTimeout(statusTimer);
        statusTimer = setTimeout(() => (drawerStatus.textContent = ""), 2000);
      };

      const chip = (label: string, attributes: Record<string, string>) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className =
          "rounded-full border border-border bg-transparent px-2 py-0.5 text-xs text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent";
        button.textContent = label;
        for (const [key, value] of Object.entries(attributes)) button.setAttribute(key, value);
        return button;
      };

      const renderMeta = () => {
        const entry = selected ? entryByName.get(nameOf(selected)) : null;
        if (!entry) return;
        drawerCategories.replaceChildren(
          ...entry.categories.map((id) => chip(categoryTitles[id] ?? id, { "data-filter-category": id })),
        );
        drawerTags.replaceChildren(...entry.tags.slice(0, 12).map((tag) => chip(tag, { "data-filter-tag": tag })));
        document.querySelector<HTMLElement>("#drawerMeta")!.hidden = entry.categories.length + entry.tags.length === 0;
      };

      const render = () => {
        const icon = currentIcon();
        if (!icon) return;
        const settings = store.get();
        drawerCode.innerHTML = snippetHtml(templates, activeTab, icon, settings);
        renderPreviews(drawer, icon, settings);
        for (const button of tabButtons) button.setAttribute("aria-selected", String(button.dataset.tab === activeTab));
      };

      // Prev/next follow what's on screen (the ranked matches, or the full
      // grid) by entry, so they never force unrendered matches into the DOM.
      const visibleEntries = () => matches ?? entries;
      const selectedIndex = () => {
        const entry = selected ? entryByName.get(nameOf(selected)) : undefined;
        return entry ? visibleEntries().indexOf(entry) : -1;
      };

      const syncNavigation = () => {
        const index = selectedIndex();
        document.querySelector<HTMLButtonElement>("#drawerPrev")!.disabled = index <= 0;
        document.querySelector<HTMLButtonElement>("#drawerNext")!.disabled = index < 0 || index >= visibleEntries().length - 1;
      };

      const select = (card: HTMLAnchorElement) => {
        selected?.setAttribute("aria-current", "false");
        selected = card;
        card.setAttribute("aria-current", "true");
        const name = nameOf(card);
        drawerName.textContent = name;
        drawerComponent.textContent = pascalCase(name);
        drawerOpenPage.href = `/icons/${name}`;
        render();
        renderMeta();
        loadIndex()?.then(renderMeta);
        syncNavigation();
      };

      // A filter swaps which grid is on screen, so move the selection to the
      // matching tile there (or leave it alone when the icon is filtered out).
      afterFilter = () => {
        if (!selected) return;
        const entry = entryByName.get(nameOf(selected));
        if (!entry) return;
        const tile = !matches ? entry.card : matches.includes(entry) ? cloneOf(entry) : null;
        if (tile && tile !== selected) {
          selected.setAttribute("aria-current", "false");
          tile.setAttribute("aria-current", "true");
          selected = tile;
        }
        syncNavigation();
      };

      const iconParam = () => new URLSearchParams(location.search).get("icon");
      // Replace, never push: Astro's client router owns history entries.
      const setIconParam = (name: string | null) => {
        const url = new URL(location.href);
        if (name) url.searchParams.set("icon", name);
        else url.searchParams.delete("icon");
        history.replaceState(history.state, "", url);
      };

      const openDrawer = (card: HTMLAnchorElement, { updateUrl = true } = {}) => {
        hideTooltip();
        select(card);
        drawer.inert = false;
        drawer.setAttribute("data-open", "");
        if (updateUrl) setIconParam(nameOf(card) || null);
      };

      const closeDrawer = ({ updateUrl = true } = {}) => {
        if (!drawer.hasAttribute("data-open")) return;
        drawer.removeAttribute("data-open");
        drawer.inert = true;
        const card = selected;
        selected?.setAttribute("aria-current", "false");
        selected = null;
        if (updateUrl) setIconParam(null);
        if (drawer.contains(document.activeElement) || document.activeElement === document.body) card?.focus({ preventScroll: true });
      };

      const step = (direction: 1 | -1) => {
        const index = selectedIndex() + direction;
        const entry = visibleEntries()[index];
        if (!entry) return;
        // Render up to the match being stepped to, in whole batches: each batch
        // is its own chunk, and a partial one would knock the rows after it
        // out of line.
        if (matches && index >= renderedCount) {
          renderBatch(Math.ceil((index - renderedCount + 1) / batchSize) * batchSize);
        }
        const next = matches ? cloneOf(entry) : entry.card;
        openDrawer(next);
        next.scrollIntoView({ block: "nearest" });
        if (browser.contains(document.activeElement)) next.focus({ preventScroll: true });
      };

      browser.addEventListener("click", (event) => {
        const mouse = event as MouseEvent;
        // Modified clicks (new tab/window) follow the real /icons/<name> link.
        if (mouse.metaKey || mouse.ctrlKey || mouse.shiftKey || mouse.altKey || mouse.button !== 0) return;
        const card = cardFrom(event);
        if (!card) return;
        event.preventDefault();
        openDrawer(card);
      });

      // Type example queries into the search placeholder until the visitor
      // first focuses or types (or a filter fills the field), then rest for
      // good. Reduced motion, at load or switched on later, keeps it plain.
      const examples = search.dataset.examples?.split(" ") ?? [];
      const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
      if (examples.length && !reducedMotion.matches) {
        const resting = search.placeholder;
        let timer = 0;
        let stopped = false;
        const stop = () => {
          stopped = true;
          clearTimeout(timer);
          search.placeholder = resting;
        };
        const wait = (ms: number, next: () => void) => {
          if (!stopped) timer = window.setTimeout(next, ms);
        };
        // Shows the first `length` letters of an example, or the resting text at 0.
        const show = (exampleIndex: number, length: number) => {
          if (search.value) return stop();
          const word = examples[exampleIndex % examples.length];
          search.placeholder = length ? `Try “${word.slice(0, length)}”` : resting;
          return word;
        };
        const type = (exampleIndex: number, length: number) => {
          const word = show(exampleIndex, length);
          if (!word) return;
          if (length < word.length) wait(90, () => type(exampleIndex, length + 1));
          else wait(1800, () => erase(exampleIndex, length - 1));
        };
        const erase = (exampleIndex: number, length: number) => {
          if (!show(exampleIndex, length)) return;
          if (length > 0) wait(40, () => erase(exampleIndex, length - 1));
          else wait(1600, () => type(exampleIndex + 1, 1));
        };
        if (document.activeElement === search || search.value) stop();
        else wait(2400, () => type(0, 1));
        search.addEventListener("focus", stop, { signal });
        search.addEventListener("input", stop, { signal });
        reducedMotion.addEventListener("change", (event) => event.matches && stop(), { signal });
        signal.addEventListener("abort", () => clearTimeout(timer));
      }

      const chooseTab = (tab: string) => {
        activeTab = tab;
        try {
          localStorage.setItem(tabKey, activeTab);
        } catch {
          // Storage can be unavailable; the tab still switches.
        }
        render();
      };
      for (const tab of tabButtons) {
        tab.addEventListener("click", () => chooseTab(tab.dataset.tab ?? "react"));
      }

      const agentPromptText = document.querySelector<HTMLTextAreaElement>("#agentPromptText")!;
      const agentPromptStatus = document.querySelector<HTMLElement>("#agentPromptStatus")!;
      let agentPromptTimer: ReturnType<typeof setTimeout> | undefined;
      document.querySelector("#agentPromptCopy")?.addEventListener("click", async (event) => {
        const button = event.currentTarget as HTMLButtonElement;
        let copied = true;
        try {
          await copyText(agentPromptText.value);
        } catch {
          // Clipboard access can be refused; show the prompt selected so it can be copied by hand.
          copied = false;
          agentPromptText.hidden = false;
          agentPromptText.focus();
          agentPromptText.select();
        }
        button.dataset.state = copied ? "copied" : "failed";
        agentPromptStatus.textContent = copied
          ? "Prompt copied. Paste it into your agent."
          : "Your browser blocked copying. The prompt is selected below.";
        clearTimeout(agentPromptTimer);
        agentPromptTimer = setTimeout(() => {
          delete button.dataset.state;
          agentPromptStatus.textContent = "";
        }, 2400);
      });
      signal.addEventListener("abort", () => clearTimeout(agentPromptTimer));

      document.querySelector("#drawerClose")?.addEventListener("click", () => closeDrawer());
      document.querySelector("#drawerPrev")?.addEventListener("click", () => step(-1));
      document.querySelector("#drawerNext")?.addEventListener("click", () => step(1));

      document.addEventListener(
        "keydown",
        (event) => {
          if (event.key === "Escape") {
            hideTooltip();
            if (!document.querySelector(":popover-open")) closeDrawer();
            return;
          }
          if (!drawer.hasAttribute("data-open") || event.altKey || event.metaKey || event.ctrlKey) return;
          const target = event.target as HTMLElement;
          if (target.closest("input, select, textarea, [contenteditable], [role=tablist], [popover]")) return;
          if (event.key === "ArrowRight" || event.key === "ArrowLeft") {
            event.preventDefault();
            step(event.key === "ArrowRight" ? 1 : -1);
          }
        },
        { signal },
      );

      drawer.addEventListener("click", async (event) => {
        const target = event.target as HTMLElement;
        const filterCategory = target.closest<HTMLElement>("[data-filter-category]")?.dataset.filterCategory;
        const filterTag = target.closest<HTMLElement>("[data-filter-tag]")?.dataset.filterTag;
        if (filterCategory || filterTag) {
          if (filterCategory) categorySelect.value = filterCategory;
          if (filterTag) search.value = filterTag;
          filterNow();
          return;
        }
        const action = target.closest<HTMLElement>("[data-action]")?.dataset.action;
        const icon = currentIcon();
        if (!action || !icon) return;
        try {
          if (action === "copy-code") {
            await copyText(snippetText(activeTab, icon, store.get()));
            setStatus("Snippet copied.");
          } else {
            setStatus(await runAction(action, icon, store.get(), version, drawer));
          }
        } catch {
          setStatus("Couldn't complete that action in this browser.");
        }
      });

      wireMenus(drawer);

      // Keep the grid's last rows reachable above the open drawer.
      const syncClearance = () => {
        explorer.style.paddingBottom = drawer.hasAttribute("data-open") ? `${drawer.offsetHeight + 24}px` : "";
      };
      const resizeObserver = new ResizeObserver(syncClearance);
      resizeObserver.observe(drawer);
      const openObserver = new MutationObserver(syncClearance);
      openObserver.observe(drawer, { attributes: true, attributeFilter: ["data-open"] });

      // Swipe the drawer down to close it on touch screens.
      let dragStart: number | null = null;
      const dragZones = [document.querySelector<HTMLElement>("#drawerHandle"), document.querySelector<HTMLElement>("#drawerHeader")];
      for (const zone of dragZones) {
        zone?.addEventListener("pointerdown", (event) => {
          if (event.pointerType !== "touch" || (event.target as HTMLElement).closest("button, a")) return;
          dragStart = event.clientY;
          drawer.style.transition = "none";
        });
      }
      addEventListener("pointermove", (event) => {
        if (dragStart === null) return;
        drawer.style.transform = `translateY(${Math.max(0, event.clientY - dragStart)}px)`;
      }, { signal });
      const endDrag = () => {
        dragStart = null;
        drawer.style.transition = "";
        drawer.style.transform = "";
      };
      addEventListener("pointerup", (event) => {
        if (dragStart === null) return;
        const distance = event.clientY - dragStart;
        endDrag();
        if (distance > 80) closeDrawer();
      }, { signal });
      // The browser cancels the pointer when it takes the touch over as a
      // scroll; reset without closing so no stale drag follows later touches.
      addEventListener("pointercancel", () => {
        if (dragStart !== null) endDrag();
      }, { signal });

      // Customizer: shared with icon pages through localStorage. The grid
      // previews stroke width and color live.
      const customizer = drawer.querySelector<HTMLElement>("[data-customizer]");
      if (customizer) bindCustomizer(customizer, store);
      store.subscribe((settings) => {
        browser.style.setProperty("--icon-stroke", String(settings.strokeWidth));
        if (settings.color === iconDefaults.color) browser.style.removeProperty("--icon-color");
        else browser.style.setProperty("--icon-color", settings.color);
        render();
      });
      const wideScreen = matchMedia("(min-width: 768px)");
      drawerCustomize.open = wideScreen.matches;

      // Deep link: `/?icon=name` opens the drawer on that icon.
      const linked = iconParam();
      const linkedCard = linked ? entryByName.get(linked)?.card : null;
      if (linkedCard) {
        openDrawer(linkedCard, { updateUrl: false });
        linkedCard.scrollIntoView({ block: "center" });
      }

      signal.addEventListener("abort", () => {
        sentinelObserver.disconnect();
        resizeObserver.disconnect();
        openObserver.disconnect();
      });
    });
  </script>
</PageLayout>

<style is:global>
  html,
  body {
    overflow-x: clip;
  }

  /* Compact the Shiki-highlighted drawer snippet. The ID selector outranks the
     shared `.prose` code rules for layout while leaving the theme's colors and
