---
import PageLayout from "blume/components/layout/PageLayout.astro";
import CodeBlock from "blume/components/content/CodeBlock.astro";
import data from "blume:data";
import { categories, icons, iconsByName } from "vadivam/manifest";
import { iconLastmods } from "../../../../scripts/icon-lastmods.mjs";
import { frameworks, iconDefaults, installCommand } from "../../../../scripts/snippets.mjs";
import pkg from "../../../../package.json";
import ActionMenus from "../_lib/ActionMenus.astro";
import Customizer from "../_lib/Customizer.astro";
import VIcon from "../_lib/VIcon.astro";
import { buildSnippetTemplates, serializeForScript } from "../_lib/snippet-templates";
import { snippetHtml } from "../_lib/icon-tools";
import { relatedIcons } from "../_lib/related-icons";
import { lucideSvg, lucideVersion } from "../_lib/lucide";

export function getStaticPaths() {
  const lastmods = iconLastmods();
  return icons.map((icon) => ({
    params: { name: icon.name },
    props: { icon, lastModified: lastmods.get(icon.name) },
  }));
}

const { config } = data;
const { icon, lastModified } = Astro.props;
const svg = iconsByName[icon.name].svg;
const c = icon.componentName;

// The client swaps the manager into each tab's install line; npm is the default.
const packageManagers = ["npm", "pnpm", "bun", "yarn"];

// Every icon page shares one template set; each page ships only the SVG shell
// for its own path count.
const pathCounts = [...new Set(icons.map((item) => (item.svg.match(/ d="/g) ?? []).length))].filter((count) => count > 0);
const allTemplates = await buildSnippetTemplates(config.codeThemes, pathCounts);
const pathCount = String((svg.match(/ d="/g) ?? []).length);
const templates = { ...allTemplates, svg: { [pathCount]: allTemplates.svg[pathCount] ?? "" } };
const iconRef = { name: icon.name, component: c, svg };
const snippetTabs = [
  ...frameworks.map(({ id, label, packageName, registry }) => ({
    id,
    label,
    packageName,
    // Only npm installs follow the package manager switch.
    npm: registry === "npm",
    install: installCommand(id, { version: pkg.version }),
  })),
  { id: "svg", label: "SVG", packageName: "vadivam", npm: true, install: "npm install vadivam" },
];
const index = icons.findIndex((item) => item.name === icon.name);
const previous = icons[index - 1];
const next = icons[index + 1];
const related = relatedIcons(icon.name);
const lucide = lucideSvg(c);
const sized = (markup: string, size: number) =>
  markup.replace(/ width="24"/, ` width="${size}"`).replace(/ height="24"/, ` height="${size}"`);
// How the zoomed preview draws the icon; the last three need Lucide's drawing.
const compareModes = [
  { id: "vadivam", label: "Vadivam", title: "Vadivam's drawing" },
  { id: "lucide", label: "Lucide", title: `Lucide ${lucideVersion}'s drawing` },
  { id: "overlay", label: "Overlay", title: "Vadivam drawn over Lucide" },
  { id: "split", label: "Split", title: "Drag to compare Vadivam and Lucide" },
];
const realSizes = [16, 20, 24, 32, 48];
const primaryCategory = icon.categories[0];
const updated = lastModified
  ? new Date(`${lastModified}T00:00:00Z`).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" })
  : null;
const guides = [
  { title: "Usage & styling", href: "/docs/usage", description: "Size, color, and stroke width across every framework." },
  { title: "Accessibility", href: "/docs/accessibility", description: "Hide decorative icons and name meaningful ones." },
  { title: "Dynamic icons", href: "/docs/dynamic-icons", description: "Load an icon by name when it comes from data at runtime." },
  { title: "Design guide", href: "/docs/design-guide", description: "The grid, stroke, and shape rules every Vadivam icon follows." },
];
const categoryTitles = new Map(categories.map((category) => [category.id, category.title]));

const pageTitle = `${c} icon — Vadivam`;
const pageDescription = `${c} is a free, open-source 24px outline icon from Vadivam. Download the SVG or use it with React and other supported frameworks.`;
const chipClass =
  "rounded-full border border-border px-2 py-0.5 text-xs text-muted-foreground no-underline transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent";
const tabClass =
  "flex-none border-0 border-b-2 border-transparent bg-transparent px-0.5 py-2.5 text-xs text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent aria-selected:border-foreground aria-selected:text-foreground";
const segmentClass =
  "rounded-md border border-transparent bg-transparent px-2 py-1 text-xs text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent aria-pressed:border-border aria-pressed:bg-background aria-pressed:text-foreground aria-pressed:shadow-xs";
const sectionClass = "m-0 text-sm font-medium text-foreground";
const ghostButtonClass =
  "grid size-8 flex-none place-items-center rounded-md border-0 bg-transparent p-0 text-muted-foreground no-underline transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent";
const nameChipClass =
  "inline-flex items-center gap-1 rounded-md border-0 bg-muted py-0.5 ps-1.5 pe-1 font-mono text-xs text-foreground transition-colors hover:bg-muted/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent";
const iconButtonClass =
  "grid size-7 flex-none place-items-center rounded-md border-0 bg-transparent p-0 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent";
const menuClass =
  "m-0 min-w-52 rounded-md border border-border bg-background p-3 text-foreground shadow-lg [position:fixed] [inset:auto]";

// PageLayout's built-in JSON-LD is disabled so this page can describe the icon,
// its image, and its breadcrumb trail in one graph (blume's default would emit
// an article node colliding with this page's #page entity).
const site = config.site?.replace(/\/$/, "");
const iconUrl = site ? `${site}/icons/${icon.name}` : `/icons/${icon.name}`;
const structuredData = site
  ? {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": `${site}#website`,
          name: config.title,
          url: `${site}/`,
        },
        {
          "@type": "WebPage",
          "@id": `${iconUrl}#page`,
          name: pageTitle,
          description: pageDescription,
          url: iconUrl,
          isPartOf: { "@id": `${site}#website` },
          primaryImageOfPage: { "@id": `${iconUrl}#image` },
          ...(lastModified && { dateModified: lastModified }),
          about: {
            "@type": "CreativeWork",
            name: `${c} icon`,
            keywords: [icon.name, c, ...icon.tags, "vadivam", "svg icon", "outline icon", "24px icon"].join(", "),
          },
        },
        {
          "@type": "ImageObject",
          "@id": `${iconUrl}#image`,
          name: `${c} icon`,
          contentUrl: `${site}/icons/${icon.name}.svg`,
          encodingFormat: "image/svg+xml",
        },
        {
          "@type": "BreadcrumbList",
          itemListElement: [
            { "@type": "ListItem", position: 1, name: "Icons", item: `${site}/` },
            { "@type": "ListItem", position: 2, name: c, item: iconUrl },
          ],
        },
      ],
    }
  : null;
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  favicon={config.favicon}
  appleIcon={config.appleIcon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  ogImage="/og.png"
  ogImageAlt={`${c} icon — Vadivam 24px outline icon`}
  ogImageSize={{ width: 1200, height: 630 }}
  x={config.x}
  structuredDataEnabled={false}
  page={{ title: pageTitle, description: pageDescription, route: `/icons/${icon.name}` }}
>
  <main id="iconDetail" class="mx-auto w-full max-w-5xl px-4 pt-4 pb-20 md:px-6">
    <div class="flex items-center justify-between gap-4 text-sm">
      <nav class="flex min-w-0 items-center gap-1.5 text-muted-foreground" aria-label="Breadcrumb">
        <a class="no-underline hover:text-foreground" href="/">Icons</a>
        {primaryCategory && (
          <>
            <span aria-hidden="true">/</span>
            <a class="truncate no-underline hover:text-foreground" href={`/?category=${primaryCategory}`}>{categoryTitles.get(primaryCategory) ?? primaryCategory}</a>
          </>
        )}
      </nav>
      <nav class="-me-2 flex flex-none items-center" aria-label="Previous and next icon">
        {previous && (
          <a class={ghostButtonClass} href={`/icons/${previous.name}`} rel="prev" title={`Previous: ${previous.name}`} aria-label={`Previous icon, ${previous.name}`}>
            <VIcon name="chevron-left" size={16} />
          </a>
        )}
        {next && (
          <a class={ghostButtonClass} href={`/icons/${next.name}`} rel="next" title={`Next: ${next.name}`} aria-label={`Next icon, ${next.name}`}>
            <VIcon name="chevron-right" size={16} />
          </a>
        )}
      </nav>
    </div>

    <section class="mt-4 grid gap-6 lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-10" aria-label="Preview and export">
      <div class="relative grid content-start overflow-hidden rounded-xl text-foreground" id="previewStage" data-background="auto" data-compare="vadivam" style="--split: 50%">
        <div class="flex items-center justify-between gap-2 p-3">
          {lucide ? (
            <div class="flex gap-0.5 rounded-lg bg-[color-mix(in_oklab,currentColor_6%,transparent)] p-0.5" role="group" aria-label="Preview drawing">
              {compareModes.map((mode, index) => (
                <button class={segmentClass} type="button" data-compare-mode={mode.id} aria-pressed={index === 0 ? "true" : "false"} title={mode.title}>{mode.label}</button>
              ))}
            </div>
          ) : <span />}
          <button class={ghostButtonClass} type="button" popovertarget="viewMenu" aria-haspopup="dialog" aria-label="View options" title="View options">
            <VIcon name="settings-2" size={16} />
          </button>
          <div class={menuClass} id="viewMenu" popover data-menu role="dialog" aria-label="View options">
            <div class="grid gap-3 text-xs">
              <div class="grid gap-1.5">
                <span class="text-muted-foreground">Background</span>
                <div class="flex gap-0.5 rounded-lg bg-muted p-0.5" role="group" aria-label="Preview background">
                  <button class:list={[segmentClass, "flex-1"]} type="button" data-background="auto" aria-pressed="true">Auto</button>
                  <button class:list={[segmentClass, "flex-1"]} type="button" data-background="light" aria-pressed="false">Light</button>
                  <button class:list={[segmentClass, "flex-1"]} type="button" data-background="dark" aria-pressed="false">Dark</button>
                </div>
              </div>
              <label class="flex items-center justify-between gap-2">
                <span class="text-muted-foreground">Pixel grid</span>
                <input class="accent-accent" type="checkbox" id="pixelGrid" checked />
              </label>
            </div>
          </div>
        </div>

        <div class="compare-zoom relative mx-auto mt-4 mb-10 aspect-square w-[min(15rem,70%)]">
          {lucide && <div class="compare-layer" data-layer="lucide" data-lucide-preview="240" data-zoom aria-hidden="true" set:html={sized(lucide, 240)} />}
          <div class="compare-layer" data-layer="vadivam" data-icon-preview="240" data-zoom aria-hidden="true" set:html={sized(svg, 240)} />
          <div class="pixel-grid pointer-events-none absolute inset-0" id="pixelGridOverlay" aria-hidden="true"></div>
          {lucide && (
            <>
              <span class="compare-label compare-label-start" aria-hidden="true">Vadivam</span>
              <span class="compare-label compare-label-end" aria-hidden="true">Lucide</span>
              <div class="compare-divider" aria-hidden="true"><span class="compare-handle"><VIcon name="chevrons-left-right" size={12} /></span></div>
              <input class="compare-range" type="range" min="0" max="100" step="1" value="50" id="compareRange" aria-label="Split position between Vadivam and Lucide" />
            </>
          )}
        </div>

        <div class="size-strip" aria-label="Real-size previews">
          <span class="size-strip-label" data-size-layer="lucide" aria-hidden="true">Vadivam</span>
          {realSizes.map((size) => (
            <span class="grid place-items-center" data-icon-preview={size} aria-hidden="true" set:html={sized(svg, size)} />
          ))}
          {lucide && (
            <>
              <span class="size-strip-label" data-size-layer="lucide" aria-hidden="true">Lucide</span>
              {realSizes.map((size) => (
                <span class="grid place-items-center" data-size-layer="lucide" data-lucide-preview={size} aria-hidden="true" set:html={sized(lucide, size)} />
              ))}
            </>
          )}
          <span class="size-strip-label" data-size-layer="lucide" aria-hidden="true"></span>
          {realSizes.map((size) => (
            <span class="size-strip-size">{size}</span>
          ))}
        </div>

        {lucide && (
          <p class="compare-note m-0 flex flex-wrap items-center justify-between gap-x-3 gap-y-1 px-4 pb-3 text-[0.68rem]" data-size-layer="lucide">
            <span>
              Lucide {lucideVersion} © Lucide Contributors, <a class="text-inherit hover:underline" href="https://github.com/lucide-icons/lucide/blob/main/LICENSE">ISC</a>. Same name, grid, and stroke, so swapping keeps your layout.
            </span>
            <a class="inline-flex items-center gap-1 text-inherit no-underline hover:underline" href="/docs/migrate-from-lucide">Migrate from Lucide<VIcon name="arrow-right" size={12} /></a>
          </p>
        )}
      </div>

      <div class="grid content-start gap-5">
        <header class="grid gap-2">
          <h1 class="m-0 min-w-0 break-words text-[clamp(1.5rem,3vw,1.875rem)] font-semibold leading-tight tracking-[-0.02em]">{c}</h1>
          <div class="flex flex-wrap items-center gap-1.5">
            <button class={nameChipClass} type="button" data-action="copy-name" title="Copy icon name">{icon.name}<VIcon name="copy" size={12} class="text-muted-foreground" /></button>
            <button class={nameChipClass} type="button" data-action="copy-component" title="Copy component name">{c}<VIcon name="copy" size={12} class="text-muted-foreground" /></button>
          </div>
          <p class="m-0 flex flex-wrap gap-x-1.5 text-xs text-muted-foreground">
            {icon.categories.map((id, index) => (
              <>
                {index > 0 && <span aria-hidden="true">·</span>}
                <a class="text-muted-foreground no-underline hover:text-foreground" href={`/?category=${id}`}>{categoryTitles.get(id) ?? id}</a>
              </>
            ))}
          </p>
        </header>

        <div class="relative grid gap-2">
          <button
            class="inline-flex w-full items-center justify-center gap-1.5 rounded-md border border-accent bg-accent px-3 py-2 text-sm text-accent-foreground transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
            type="button"
            data-action="copy-svg"
          ><VIcon name="code" size={15} /><span>Copy SVG</span></button>
          <div class="grid grid-cols-2 gap-2 [&>button]:justify-center">
            <ActionMenus id="pageMenu" />
          </div>
          <p class="absolute inset-x-0 top-full m-0 mt-1 text-center text-xs text-muted-foreground" id="pageStatus" aria-live="polite"></p>
        </div>

        <details class="customize group mt-2 border-y border-border" id="customize">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-2 py-3 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent [&::-webkit-details-marker]:hidden">
            <span class="inline-flex items-center gap-2">
              Customize
              <span class="size-1.5 rounded-full bg-accent" id="customizedDot" hidden></span>
            </span>
            <span class="inline-flex items-center gap-2 font-mono text-xs text-muted-foreground">
              <span id="customizeSummary">24px · 2</span>
              <VIcon name="chevron-down" size={14} class="transition-transform group-open:rotate-180" />
            </span>
          </summary>
          <Customizer class="pb-4" />
        </details>

        <p class="m-0 text-xs text-muted-foreground">
          <a class="text-muted-foreground hover:text-foreground" href="https://github.com/praveenjuge/vadivam/blob/main/LICENSE">MIT License</a>
          {updated && <> · Updated <time datetime={lastModified}>{updated}</time></>}
        </p>
      </div>
    </section>

    <section class="mt-16" aria-labelledby="codeHeading">
      <div class="flex items-center justify-between gap-2">
        <h2 class={sectionClass} id="codeHeading">Use it</h2>
        <label class="relative inline-flex items-center text-xs text-muted-foreground">
          <span class="sr-only">Package manager</span>
          <select class="appearance-none rounded-md border border-border bg-transparent py-1 ps-2 pe-6 font-mono text-xs text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent" id="packageManager">
            {packageManagers.map((manager) => <option value={manager}>{manager}</option>)}
          </select>
          <VIcon name="chevron-down" size={12} class="pointer-events-none absolute end-1.5" />
        </label>
      </div>
      <div class="mt-3 rounded-xl border border-border" data-tabgroup="framework">
        <div class="flex gap-4 overflow-x-auto border-b border-border px-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" role="tablist" aria-label="Framework snippet">
          {
            snippetTabs.map((tab, index) => (
              <button
                class={tabClass}
                type="button"
                role="tab"
                id={`tab-${tab.id}`}
                data-tab={tab.id}
                data-title={tab.label}
                aria-controls={`panel-${tab.id}`}
                aria-selected={index === 0 ? "true" : "false"}
              >
                {tab.label}
              </button>
            ))
          }
        </div>
        {
          snippetTabs.map((tab, index) => (
            <div class="grid min-w-0" id={`panel-${tab.id}`} role="tabpanel" aria-labelledby={`tab-${tab.id}`} hidden={index !== 0}>
              <div class="flex min-w-0 items-center gap-2 border-b border-border ps-4 pe-2">
                <span class="flex-none font-mono text-xs text-muted-foreground select-none" aria-hidden="true">$</span>
                <code class="min-w-0 flex-1 truncate bg-transparent py-2.5 font-mono text-[0.78rem]" data-install={tab.npm ? tab.packageName : undefined}>{tab.install}</code>
                <button class={iconButtonClass} type="button" data-action="copy-install" data-package={tab.packageName} data-command={tab.npm ? undefined : tab.install} aria-label={`Copy install command for ${tab.packageName}`}><VIcon name="copy" size={14} /></button>
              </div>
              <div class="snippet-panel relative min-w-0">
                <div class="prose max-w-none" data-snippet={tab.id} set:html={snippetHtml(templates, tab.id, iconRef, iconDefaults)} />
                <button
                  class="absolute end-2 top-2 z-10 grid size-7 place-items-center rounded-md border-0 bg-background p-0 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                  type="button"
                  data-action="copy-snippet"
                  data-snippet-tab={tab.id}
                  aria-label="Copy snippet"
                ><VIcon name="copy" size={14} /></button>
              </div>
              {tab.id === "svg" && (
                <>
                  <div class="snippet-panel relative min-w-0 border-t border-border">
                    <CodeBlock lang="ts" code={`import iconUrl from "vadivam/icons/${icon.fileName}";`} icons={false} />
                  </div>
                  <div class="snippet-panel relative min-w-0 border-t border-border">
                    <CodeBlock lang="html" code={`<img src="https://cdn.jsdelivr.net/npm/vadivam@${pkg.version}/dist/icons/${icon.fileName}" width="24" height="24" alt="" />`} icons={false} />
                  </div>
                </>
              )}
            </div>
          ))
        }
      </div>
    </section>

    {(related.length > 0 || icon.tags.length > 0) && (
      <section class="mt-16" aria-labelledby="relatedHeading">
        <h2 class={sectionClass} id="relatedHeading">Related icons</h2>
        {related.length > 0 && (
          <div class="mt-3 grid grid-cols-3 gap-1 sm:grid-cols-6">
            {related.map((item) => (
              <a class="related-tile" href={`/icons/${item.name}`}>
                <span aria-hidden="true" set:html={item.svg} />
                <span class="related-name">{item.name}</span>
              </a>
            ))}
          </div>
        )}
        {icon.tags.length > 0 && (
          <div class="mt-4 flex flex-wrap items-center gap-1.5">
            <span class="me-1 text-xs text-muted-foreground">Tags</span>
            {icon.tags.map((tag) => (
              <a class={chipClass} href={`/?q=${encodeURIComponent(tag)}`}>{tag}</a>
            ))}
          </div>
        )}
      </section>
    )}

    <nav class="mt-16 grid gap-x-6 border-t border-border pt-6 sm:grid-cols-2 lg:grid-cols-4" aria-label="Learn more">
      {guides.map((guide) => (
        <a class="group grid gap-1 py-2 text-foreground no-underline" href={guide.href}>
          <span class="inline-flex items-center gap-1 text-sm font-medium">{guide.title}<VIcon name="arrow-right" size={12} class="text-muted-foreground transition-transform group-hover:translate-x-0.5" /></span>
          <span class="text-xs text-muted-foreground">{guide.description}</span>
        </a>
      ))}
    </nav>
  </main>

  {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}

  <script is:inline type="application/json" id="snippetTemplates" set:html={serializeForScript(templates)}></script>
  <script is:inline type="application/json" id="iconData" set:html={serializeForScript({ icon: iconRef, lucide, version: pkg.version })}></script>

  <script>
    import {
      bindCustomizer,
      copyText,
      createSettingsStore,
      isDefaultSettings,
      readTemplates,
      renderPreviews,
      runAction,
      snippetHtml,
      snippetText,
      wireMenus,
      type IconRef,
    } from "../_lib/icon-tools";

    // Astro's client router swaps pages without reloading and runs a bundled
    // script once, so set each icon page up on every page load.
    document.addEventListener("astro:page-load", () => {
      if (!document.querySelector("#iconDetail")) return;

      const detail = document.querySelector<HTMLElement>("#iconDetail")!;
      const status = document.querySelector<HTMLElement>("#pageStatus")!;
      const stage = document.querySelector<HTMLElement>("#previewStage")!;
      const gridToggle = document.querySelector<HTMLInputElement>("#pixelGrid")!;
      const overlay = document.querySelector<HTMLElement>("#pixelGridOverlay")!;
      const summary = document.querySelector<HTMLElement>("#customizeSummary")!;
      const customizedDot = document.querySelector<HTMLElement>("#customizedDot")!;
      const templates = readTemplates("snippetTemplates");
      const { icon, lucide, version } = JSON.parse(document.getElementById("iconData")?.textContent ?? "{}") as {
        icon: IconRef;
        lucide: string | null;
        version: string;
      };
      const store = createSettingsStore({ url: true });
      const tabKey = "vadivam:tab";
      const backgroundKey = "vadivam:preview-background";
      let statusTimer: ReturnType<typeof setTimeout> | undefined;

      const setStatus = (message: string) => {
        status.textContent = message;
        clearTimeout(statusTimer);
        statusTimer = setTimeout(() => (status.textContent = ""), 2000);
      };

      const remember = (key: string, value: string) => {
        try {
          localStorage.setItem(key, value);
        } catch {
          // Storage can be unavailable; the choice still applies to this page.
        }
      };
      const recall = (key: string) => {
        try {
          return localStorage.getItem(key);
        } catch {
          return null;
        }
      };

      // Each tab group switches its own panels; the framework choice is remembered.
      const selectTab = (group: HTMLElement, id: string) => {
        const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
        if (!buttons.some((button) => button.dataset.tab === id)) return;
        for (const button of buttons) {
          const active = button.dataset.tab === id;
          button.setAttribute("aria-selected", String(active));
          const panel = document.getElementById(button.getAttribute("aria-controls") ?? "");
          if (panel) panel.hidden = !active;
        }
      };
      for (const group of detail.querySelectorAll<HTMLElement>("[data-tabgroup]")) {
        group.addEventListener("click", (event) => {
          const tab = (event.target as HTMLElement).closest<HTMLElement>('[role="tab"]')?.dataset.tab;
          if (!tab) return;
          selectTab(group, tab);
          if (group.dataset.tabgroup === "framework") remember(tabKey, tab);
        });
      }
      const frameworkGroup = detail.querySelector<HTMLElement>('[data-tabgroup="framework"]');
      if (frameworkGroup) selectTab(frameworkGroup, recall(tabKey) ?? "react");

      // One package manager choice rewrites every tab's install line.
      const managerKey = "vadivam:package-manager";
      const packageManagers = ["npm", "pnpm", "bun", "yarn"];
      const installCommand = (manager: string, packageName: string) =>
        `${manager} ${manager === "npm" ? "install" : "add"} ${packageName}`;
      const managerSelect = detail.querySelector<HTMLSelectElement>("#packageManager")!;
      const setManager = (manager: string) => {
        if (!packageManagers.includes(manager)) return;
        managerSelect.value = manager;
        for (const line of detail.querySelectorAll<HTMLElement>("[data-install]")) {
          line.textContent = installCommand(manager, line.dataset.install ?? "");
        }
      };
      const currentManager = () => managerSelect.value;
      managerSelect.addEventListener("change", () => {
        setManager(managerSelect.value);
        remember(managerKey, managerSelect.value);
      });
      setManager(recall(managerKey) ?? "npm");

      const setBackground = (value: string) => {
        stage.dataset.background = value;
        for (const button of detail.querySelectorAll<HTMLElement>("[data-background]")) {
          if (button !== stage) button.setAttribute("aria-pressed", String(button.dataset.background === value));
        }
      };
      detail.querySelector('[aria-label="Preview background"]')?.addEventListener("click", (event) => {
        const value = (event.target as HTMLElement).closest<HTMLElement>("[data-background]")?.dataset.background;
        if (!value) return;
        setBackground(value);
        remember(backgroundKey, value);
      });
      setBackground(recall(backgroundKey) ?? "auto");

      // The zoomed preview shows Vadivam, Lucide, both overlaid, or a split
      // with a draggable divider; the choice is remembered like the others.
      const compareKey = "vadivam:compare";
      const setCompare = (mode: string) => {
        const buttons = Array.from(detail.querySelectorAll<HTMLElement>("[data-compare-mode]"));
        if (!buttons.some((button) => button.dataset.compareMode === mode)) return;
        stage.dataset.compare = mode;
        for (const button of buttons) button.setAttribute("aria-pressed", String(button.dataset.compareMode === mode));
      };
      detail.querySelector('[aria-label="Preview drawing"]')?.addEventListener("click", (event) => {
        const mode = (event.target as HTMLElement).closest<HTMLElement>("[data-compare-mode]")?.dataset.compareMode;
        if (!mode) return;
        setCompare(mode);
        remember(compareKey, mode);
      });
      setCompare(recall(compareKey) ?? "vadivam");
      document.querySelector<HTMLInputElement>("#compareRange")?.addEventListener("input", (event) => {
        stage.style.setProperty("--split", `${(event.target as HTMLInputElement).value}%`);
      });

      gridToggle.addEventListener("change", () => {
        overlay.hidden = !gridToggle.checked;
        remember("vadivam:pixel-grid", String(gridToggle.checked));
      });
      gridToggle.checked = recall("vadivam:pixel-grid") !== "false";
      overlay.hidden = !gridToggle.checked;

      const customizer = detail.querySelector<HTMLElement>("[data-customizer]");
      if (customizer) bindCustomizer(customizer, store);
      store.subscribe((settings) => {
        renderPreviews(detail, icon, settings);
        if (lucide) renderPreviews(detail, { ...icon, svg: lucide }, settings, "lucide-preview");
        summary.textContent = `${settings.size}px · ${settings.strokeWidth}${settings.color === "currentColor" ? "" : ` · ${settings.color}`}`;
        customizedDot.hidden = isDefaultSettings(settings);
        for (const panel of detail.querySelectorAll<HTMLElement>("[data-snippet]")) {
          panel.innerHTML = snippetHtml(templates, panel.dataset.snippet ?? "react", icon, settings);
        }
      });

      detail.addEventListener("click", async (event) => {
        const target = (event.target as HTMLElement).closest<HTMLElement>("[data-action]");
        if (!target) return;
        try {
          if (target.dataset.action === "copy-install") {
            await copyText(target.dataset.command ?? installCommand(currentManager(), target.dataset.package ?? ""));
            setStatus("Install command copied.");
          } else if (target.dataset.action === "copy-snippet") {
            await copyText(snippetText(target.dataset.snippetTab ?? "react", icon, store.get()));
            setStatus("Snippet copied.");
          } else if (target.dataset.action === "copy-code") {
            await copyText(target.dataset.copy ?? "");
            setStatus("Copied.");
          } else {
            setStatus(await runAction(target.dataset.action ?? "", icon, store.get(), version, stage));
          }
        } catch {
          setStatus("Couldn't complete that action in this browser.");
        }
      });

      wireMenus(detail);

      // PageLayout does not ship RootLayout's code-block copy island, so add a
      // copy button to each Blume CodeBlock (the SVG tab's asset imports).
      for (const pre of detail.querySelectorAll<HTMLElement>(".prose pre")) {
        const code = pre.querySelector("code");
        if (!code || pre.closest("[data-snippet]") || pre.querySelector("[data-action]")) continue;
        pre.classList.add("group", "relative");
        const button = document.createElement("button");
        button.type = "button";
        button.className =
          "absolute end-2 top-2 inline-flex items-center gap-1 rounded-md border border-border bg-background px-2 py-0.5 text-[0.68rem] opacity-0 transition-opacity hover:bg-muted focus-visible:opacity-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent group-hover:opacity-100";
        button.dataset.action = "copy-code";
        button.dataset.copy = code.textContent ?? "";
        button.setAttribute("aria-label", "Copy code");
        button.innerHTML = "<span>Copy</span>";
        pre.appendChild(button);
      }
    });
  </script>
</PageLayout>

<style is:global>
  /* A 24 × 24 grid over the zoomed preview: each cell is one icon pixel. */
  #iconDetail .pixel-grid {
    background-image:
      linear-gradient(to right, color-mix(in oklab, currentColor 14%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in oklab, currentColor 14%, transparent) 1px, transparent 1px);
    background-size: calc(100% / 24) calc(100% / 24);
    box-shadow: inset -1px -1px 0 color-mix(in oklab, currentColor 14%, transparent);
  }

  #previewStage[data-background="auto"] {
    background: color-mix(in oklab, var(--color-muted) 55%, transparent);
  }

  #previewStage[data-background="light"] {
    background: #fff;
    color: #111;
  }

  #previewStage[data-background="dark"] {
    background: #111;
    color: #f5f5f5;
  }

  #iconDetail .related-tile {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    min-width: 0;
    padding: 0.875rem 0.375rem 0.625rem;
    border-radius: 0.375rem;
    color: var(--color-foreground);
    text-decoration: none;
  }

  #iconDetail .related-tile:hover {
    background: var(--color-muted);
  }

  #iconDetail .related-tile:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  #iconDetail .related-tile svg {
    display: block;
  }

  #iconDetail .related-name {
    max-width: 100%;
    overflow: hidden;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.65rem;
    line-height: 1rem;
    color: var(--color-muted-foreground);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* The zoomed preview stacks Lucide under Vadivam; the stage's
     data-compare picks which drawings show and how. */
  #iconDetail .compare-layer {
    position: absolute;
    inset: 0;
  }

  #iconDetail .compare-layer > svg {
    width: 100%;
    height: 100%;
  }

  #iconDetail .compare-label,
  #iconDetail .compare-divider,
  #iconDetail .compare-range,
  #previewStage[data-compare="vadivam"] [data-layer="lucide"],
  #previewStage[data-compare="lucide"] [data-layer="vadivam"],
  #previewStage[data-compare="vadivam"] [data-size-layer="lucide"] {
    display: none;
  }

  #previewStage[data-compare="overlay"] .compare-label,
  #previewStage[data-compare="split"] .compare-label,
  #previewStage[data-compare="split"] .compare-divider,
  #previewStage[data-compare="split"] .compare-range {
    display: block;
  }

  #iconDetail .compare-label {
    position: absolute;
    top: -1.5rem;
    font-size: 0.68rem;
    line-height: 1rem;
    opacity: 0.6;
  }

  #iconDetail .compare-label-start {
    left: 0;
  }

  #iconDetail .compare-label-end {
    right: 0;
  }

  /* Overlay: Vadivam in the accent over Lucide's faded drawing. Each label
     doubles as the legend for its color. */
  #previewStage[data-compare="overlay"] [data-layer="vadivam"] svg,
  #previewStage[data-compare="overlay"] .compare-label-start {
    stroke: var(--color-accent);
    color: var(--color-accent);
    opacity: 1;
  }

  #previewStage[data-compare="overlay"] [data-layer="lucide"] svg {
    stroke: color-mix(in oklab, currentColor 30%, transparent);
  }

  /* Split: Vadivam left of the divider, Lucide right of it. */
  #previewStage[data-compare="split"] [data-layer="vadivam"] {
    clip-path: inset(0 calc(100% - var(--split)) 0 0);
  }

  #previewStage[data-compare="split"] [data-layer="lucide"] {
    clip-path: inset(0 0 0 var(--split));
  }

  #iconDetail .compare-divider {
    position: absolute;
    top: -0.5rem;
    bottom: -0.5rem;
    left: var(--split);
    width: 0;
    border-left: 1px solid var(--color-accent);
    pointer-events: none;
  }

  #iconDetail .compare-handle {
    position: absolute;
    top: 50%;
    left: 0;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 9999px;
    background: var(--color-accent);
    color: var(--color-accent-foreground);
    transform: translate(-50%, -50%);
  }

  #iconDetail .compare-zoom:has(.compare-range:focus-visible) .compare-handle {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* An invisible range input covers the drawing, so dragging anywhere on it,
     or the arrow keys, move the divider. */
  #iconDetail .compare-range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }

  /* Real sizes under the zoomed drawing: one row for Vadivam, plus a
     labelled Lucide row in the compare modes. */
  #iconDetail .size-strip {
    display: grid;
    grid-template-columns: 3.5rem repeat(5, minmax(0, 1fr));
    align-items: center;
    row-gap: 0.75rem;
    padding: 0 1rem 1.25rem;
  }

  #previewStage[data-compare="vadivam"] .size-strip {
    grid-template-columns: repeat(5, minmax(0, 1fr));
    max-width: 24rem;
    width: 100%;
    margin-inline: auto;
  }

  #iconDetail .size-strip-label {
    font-size: 0.68rem;
    opacity: 0.6;
  }

  #iconDetail .size-strip-size {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.65rem;
    text-align: center;
    opacity: 0.5;
  }

  #iconDetail .compare-note {
    opacity: 0.6;
  }

  #iconDetail .snippet-panel pre.astro-code {
    margin: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    font-size: 0.78rem;
  }

  /* Leave room for the copy button so it never covers the first line. */
  #iconDetail .snippet-panel pre.astro-code > code {
    padding-inline-end: 4.5rem;
  }
</style>
