---
import PageLayout from "blume/components/layout/PageLayout.astro";
import CodeBlock from "blume/components/content/CodeBlock.astro";
import data from "blume:data";
import { categories, icons, iconsByName } from "vadivam/manifest";
import { iconLastmods } from "../../../../scripts/icon-lastmods.mjs";
import { frameworks, iconDefaults } from "../../../../scripts/snippets.mjs";
import pkg from "../../../../package.json";
import ActionMenus from "../_lib/ActionMenus.astro";
import Customizer from "../_lib/Customizer.astro";
import VIcon from "../_lib/VIcon.astro";
import { buildSnippetTemplates, serializeForScript } from "../_lib/snippet-templates";
import { snippetHtml } from "../_lib/icon-tools";
import { relatedIcons } from "../_lib/related-icons";
import { lucideSvg, lucideVersion } from "../_lib/lucide";

export function getStaticPaths() {
  const lastmods = iconLastmods();
  return icons.map((icon) => ({
    params: { name: icon.name },
    props: { icon, lastModified: lastmods.get(icon.name) },
  }));
}

const { config } = data;
const { icon, lastModified } = Astro.props;
const svg = iconsByName[icon.name].svg;
const c = icon.componentName;

// The client swaps the manager into each tab's install line; npm is the default.
const packageManagers = ["npm", "pnpm", "bun", "yarn"];

// Every icon page shares one template set; each page ships only the SVG shell
// for its own path count.
const pathCounts = [...new Set(icons.map((item) => (item.svg.match(/ d="/g) ?? []).length))].filter((count) => count > 0);
const allTemplates = await buildSnippetTemplates(config.codeThemes, pathCounts);
const pathCount = String((svg.match(/ d="/g) ?? []).length);
const templates = { ...allTemplates, svg: { [pathCount]: allTemplates.svg[pathCount] ?? "" } };
const iconRef = { name: icon.name, component: c, svg };
const snippetTabs = [
  ...frameworks.map(({ id, label, packageName }) => ({ id, label, packageName })),
  { id: "svg", label: "SVG", packageName: "vadivam" },
];
const index = icons.findIndex((item) => item.name === icon.name);
const previous = icons[index - 1];
const next = icons[index + 1];
const related = relatedIcons(icon.name);
const lucide = lucideSvg(c);
const sized = (markup: string, size: number) =>
  markup.replace(/ width="24"/, ` width="${size}"`).replace(/ height="24"/, ` height="${size}"`);
const primaryCategory = icon.categories[0];
const updated = lastModified
  ? new Date(`${lastModified}T00:00:00Z`).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" })
  : null;
const guides = [
  { title: "Usage & styling", href: "/docs/usage", description: "Size, color, and stroke width across every framework." },
  { title: "Accessibility", href: "/docs/accessibility", description: "Hide decorative icons and name meaningful ones." },
  { title: "Dynamic icons", href: "/docs/dynamic-icons", description: "Load an icon by name when it comes from data at runtime." },
  { title: "Design guide", href: "/docs/design-guide", description: "The grid, stroke, and shape rules every Vadivam icon follows." },
];
const categoryTitles = new Map(categories.map((category) => [category.id, category.title]));

const pageTitle = `${c} icon — Vadivam`;
const pageDescription = `${c} is a free, open-source 24px outline icon from Vadivam. Download the SVG or use it with React and other supported frameworks.`;
const chipClass =
  "rounded-full border border-border px-2 py-0.5 text-xs text-muted-foreground no-underline transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent";
const tabClass =
  "flex-none rounded-md border border-transparent px-2 py-1 text-xs text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent aria-selected:border-accent aria-selected:bg-accent aria-selected:text-accent-foreground";
const segmentClass =
  "rounded-md border border-transparent bg-transparent px-2 py-1 text-xs text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent aria-pressed:border-border aria-pressed:bg-background aria-pressed:text-foreground";
const sectionClass = "m-0 text-xs font-semibold uppercase tracking-wide text-muted-foreground";
const stepClass =
  "inline-flex items-center gap-1 rounded-md px-2 py-1 font-mono text-xs text-muted-foreground no-underline transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent";
const miniButtonClass =
  "grid size-5 flex-none place-items-center rounded border-0 bg-transparent p-0 text-muted-foreground transition-colors hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent";
const iconButtonClass =
  "grid size-7 flex-none place-items-center rounded-md border-0 bg-transparent p-0 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent";

// PageLayout's built-in JSON-LD is disabled so this page can describe the icon,
// its image, and its breadcrumb trail in one graph (blume's default would emit
// an article node colliding with this page's #page entity).
const site = config.site?.replace(/\/$/, "");
const iconUrl = site ? `${site}/icons/${icon.name}` : `/icons/${icon.name}`;
const structuredData = site
  ? {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": `${site}#website`,
          name: config.title,
          url: `${site}/`,
        },
        {
          "@type": "WebPage",
          "@id": `${iconUrl}#page`,
          name: pageTitle,
          description: pageDescription,
          url: iconUrl,
          isPartOf: { "@id": `${site}#website` },
          primaryImageOfPage: { "@id": `${iconUrl}#image` },
          ...(lastModified && { dateModified: lastModified }),
          about: {
            "@type": "CreativeWork",
            name: `${c} icon`,
            keywords: [icon.name, c, ...icon.tags, "vadivam", "svg icon", "outline icon", "24px icon"].join(", "),
          },
        },
        {
          "@type": "ImageObject",
          "@id": `${iconUrl}#image`,
          name: `${c} icon`,
          contentUrl: `${site}/icons/${icon.name}.svg`,
          encodingFormat: "image/svg+xml",
        },
        {
          "@type": "BreadcrumbList",
          itemListElement: [
            { "@type": "ListItem", position: 1, name: "Icons", item: `${site}/` },
            { "@type": "ListItem", position: 2, name: c, item: iconUrl },
          ],
        },
      ],
    }
  : null;
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  favicon={config.favicon}
  appleIcon={config.appleIcon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  ogImage="/og.png"
  ogImageAlt={`${c} icon — Vadivam 24px outline icon`}
  ogImageSize={{ width: 1200, height: 630 }}
  x={config.x}
  structuredDataEnabled={false}
  page={{ title: pageTitle, description: pageDescription, route: `/icons/${icon.name}` }}
>
  <main id="iconDetail" class="mx-auto w-full max-w-5xl px-4 pt-4 pb-16 md:px-6">
    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 text-sm">
      <nav class="flex min-w-0 items-center gap-1.5 text-muted-foreground" aria-label="Breadcrumb">
        <a class="no-underline hover:text-foreground" href="/">Icons</a>
        {primaryCategory && (
          <>
            <span aria-hidden="true">/</span>
            <a class="no-underline hover:text-foreground" href={`/?category=${primaryCategory}`}>{categoryTitles.get(primaryCategory) ?? primaryCategory}</a>
          </>
        )}
        <span aria-hidden="true">/</span>
        <span class="truncate text-foreground" aria-current="page">{c}</span>
      </nav>
      <nav class="flex flex-none items-center gap-1" aria-label="Previous and next icon">
        {previous && (
          <a class={stepClass} href={`/icons/${previous.name}`} rel="prev" title={previous.name}>
            <VIcon name="chevron-left" size={14} /><span class="max-w-[9rem] truncate">{previous.name}</span>
          </a>
        )}
        {next && (
          <a class={stepClass} href={`/icons/${next.name}`} rel="next" title={next.name}>
            <span class="max-w-[9rem] truncate">{next.name}</span><VIcon name="chevron-right" size={14} />
          </a>
        )}
      </nav>
    </div>

    <header class="mt-5 grid gap-2">
      <h1 class="m-0 min-w-0 break-words text-[clamp(1.5rem,3vw,2rem)] font-semibold leading-tight tracking-[-0.02em]">{c}</h1>
      <div class="flex flex-wrap items-center gap-1.5 text-xs text-muted-foreground">
        <span class="inline-flex items-center gap-0.5 rounded-md bg-muted px-1.5 py-0.5">
          <code class="bg-transparent text-xs text-foreground">{icon.name}</code>
          <button class={miniButtonClass} type="button" data-action="copy-name" aria-label="Copy icon name"><VIcon name="copy" size={12} /></button>
        </span>
        {icon.categories.map((id) => (
          <a class={chipClass} href={`/?category=${id}`}>{categoryTitles.get(id) ?? id}</a>
        ))}
      </div>
    </header>

    <section class="mt-6 grid border-y border-border lg:grid-cols-[minmax(0,1fr)_19rem]" aria-label="Preview and export">
      <div class="grid content-start gap-4 py-4 lg:pe-6">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div class="flex gap-0.5 rounded-lg bg-muted p-0.5" role="group" aria-label="Preview background">
            <button class={segmentClass} type="button" data-background="auto" aria-pressed="true">Auto</button>
            <button class={segmentClass} type="button" data-background="light" aria-pressed="false">Light</button>
            <button class={segmentClass} type="button" data-background="dark" aria-pressed="false">Dark</button>
          </div>
          <label class="inline-flex items-center gap-2 text-xs text-muted-foreground">
            <input class="accent-accent" type="checkbox" id="pixelGrid" checked />
            Pixel grid
          </label>
        </div>
        <div class="grid gap-6 rounded-lg px-4 py-8 text-foreground" id="previewStage" data-background="auto">
          <div class="relative mx-auto aspect-square w-full max-w-60">
            <div class="absolute inset-0 [&>svg]:size-full" data-icon-preview="240" data-zoom aria-hidden="true" set:html={svg.replace(/ width="24"/, ' width="240"').replace(/ height="24"/, ' height="240"')} />
            <div class="pixel-grid pointer-events-none absolute inset-0" id="pixelGridOverlay" aria-hidden="true"></div>
          </div>
          <div class="flex items-end justify-center gap-[clamp(1rem,5vw,2.5rem)]" aria-label="Size previews">
            {[16, 20, 24, 32, 48].map((size) => (
              <div class="grid justify-items-center gap-1.5">
                <div class="grid place-items-center" data-icon-preview={size} set:html={svg.replace(/ width="24"/, ` width="${size}"`).replace(/ height="24"/, ` height="${size}"`)} />
                <span class="font-mono text-[0.65rem] opacity-60">{size}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="grid content-start gap-5 border-t border-border py-4 lg:border-t-0 lg:border-l lg:ps-6">
        <div class="grid gap-2">
          <button
            class="inline-flex w-full items-center justify-center gap-1.5 rounded-md border border-accent bg-accent px-3 py-2 text-sm text-accent-foreground transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
            type="button"
            data-action="copy-svg"
          ><VIcon name="code" size={15} /><span>Copy SVG</span></button>
          <div class="grid grid-cols-2 gap-2 [&>button]:justify-center">
            <ActionMenus id="pageMenu" />
          </div>
          <p class="m-0 min-h-4 text-center text-xs text-muted-foreground" id="pageStatus" aria-live="polite"></p>
        </div>
        <Customizer />
        <dl class="m-0 grid gap-2 border-t border-border pt-4 text-xs">
          <div class="flex items-baseline justify-between gap-3">
            <dt class="text-muted-foreground">Component</dt>
            <dd class="m-0 flex min-w-0 items-center gap-1">
              <code class="truncate bg-transparent text-xs">{c}</code>
              <button class={miniButtonClass} type="button" data-action="copy-component" aria-label="Copy component name"><VIcon name="copy" size={12} /></button>
            </dd>
          </div>
          {updated && (
            <div class="flex items-baseline justify-between gap-3">
              <dt class="text-muted-foreground">Updated</dt>
              <dd class="m-0"><time datetime={lastModified}>{updated}</time></dd>
            </div>
          )}
          <div class="flex items-baseline justify-between gap-3">
            <dt class="text-muted-foreground">License</dt>
            <dd class="m-0"><a class="text-foreground" href="https://github.com/praveenjuge/vadivam/blob/main/LICENSE">MIT</a></dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="mt-10" aria-labelledby="codeHeading">
      <div class="flex flex-wrap items-end justify-between gap-2">
        <h2 class={sectionClass} id="codeHeading">Use it</h2>
        <div class="flex gap-0.5 rounded-lg bg-muted p-0.5" role="group" aria-label="Package manager">
          {packageManagers.map((manager, index) => (
            <button class={segmentClass} type="button" data-package-manager={manager} aria-pressed={index === 0 ? "true" : "false"}>{manager}</button>
          ))}
        </div>
      </div>
      <div class="mt-3 grid gap-2" data-tabgroup="framework">
        <div class="flex gap-1 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" role="tablist" aria-label="Framework snippet">
          {
            snippetTabs.map((tab, index) => (
              <button
                class={tabClass}
                type="button"
                role="tab"
                id={`tab-${tab.id}`}
                data-tab={tab.id}
                data-title={tab.label}
                aria-controls={`panel-${tab.id}`}
                aria-selected={index === 0 ? "true" : "false"}
              >
                {tab.label}
              </button>
            ))
          }
        </div>
        {
          snippetTabs.map((tab, index) => (
            <div class="grid min-w-0 gap-2" id={`panel-${tab.id}`} role="tabpanel" aria-labelledby={`tab-${tab.id}`} hidden={index !== 0}>
              <div class="flex min-w-0 items-center gap-2 rounded-md border border-border bg-muted/40 ps-3 pe-1">
                <span class="flex-none font-mono text-xs text-muted-foreground select-none" aria-hidden="true">$</span>
                <code class="min-w-0 flex-1 truncate bg-transparent py-2 font-mono text-[0.78rem]" data-install={tab.packageName}>npm install {tab.packageName}</code>
                <button class={iconButtonClass} type="button" data-action="copy-install" data-package={tab.packageName} aria-label={`Copy install command for ${tab.packageName}`}><VIcon name="copy" size={14} /></button>
              </div>
              <div class="snippet-panel relative min-w-0">
                <div class="prose max-w-none" data-snippet={tab.id} set:html={snippetHtml(templates, tab.id, iconRef, iconDefaults)} />
                <button
                  class="absolute end-1.5 top-1.5 inline-flex items-center gap-1 rounded-md border border-border bg-background px-2 py-0.5 text-[0.68rem] transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                  type="button"
                  data-action="copy-snippet"
                  data-snippet-tab={tab.id}
                ><VIcon name="copy" size={12} /><span>Copy</span></button>
              </div>
              {tab.id === "svg" && (
                <>
                  <div class="snippet-panel relative min-w-0">
                    <CodeBlock lang="ts" code={`import iconUrl from "vadivam/icons/${icon.fileName}";`} icons={false} />
                  </div>
                  <div class="snippet-panel relative min-w-0">
                    <CodeBlock lang="html" code={`<img src="https://cdn.jsdelivr.net/npm/vadivam@${pkg.version}/dist/icons/${icon.fileName}" width="24" height="24" alt="" />`} icons={false} />
                  </div>
                </>
              )}
            </div>
          ))
        }
      </div>
    </section>

    {lucide && (
      <section class="mt-10" aria-labelledby="lucideHeading">
        <div class="flex flex-wrap items-end justify-between gap-2">
          <h2 class={sectionClass} id="lucideHeading">Compared with Lucide</h2>
          <a class="inline-flex items-center gap-1 text-xs text-muted-foreground no-underline hover:text-foreground" href="/docs/migrate-from-lucide">Migrate from Lucide<VIcon name="arrow-right" size={12} /></a>
        </div>
        <div class="mt-3 grid grid-cols-3 border-y border-border" id="lucideCompare">
          <figure class="compare-tile">
            <div class="compare-stage">
              <div class="compare-layer" aria-hidden="true" set:html={sized(svg, 160)} />
              <div class="pixel-grid compare-layer" aria-hidden="true"></div>
            </div>
            <div class="compare-sizes" aria-hidden="true" set:html={sized(svg, 24) + sized(svg, 16)} />
            <figcaption>Vadivam</figcaption>
          </figure>
          <figure class="compare-tile">
            <div class="compare-stage">
              <div class="compare-layer" aria-hidden="true" set:html={sized(lucide, 160)} />
              <div class="pixel-grid compare-layer" aria-hidden="true"></div>
            </div>
            <div class="compare-sizes" aria-hidden="true" set:html={sized(lucide, 24) + sized(lucide, 16)} />
            <figcaption>Lucide {lucideVersion}</figcaption>
          </figure>
          <figure class="compare-tile">
            <div class="compare-stage">
              <div class="compare-layer compare-lucide" aria-hidden="true" set:html={sized(lucide, 160)} />
              <div class="compare-layer compare-vadivam" aria-hidden="true" set:html={sized(svg, 160)} />
              <div class="pixel-grid compare-layer" aria-hidden="true"></div>
            </div>
            <div class="compare-sizes" aria-hidden="true">
              <span class="compare-key"><span class="compare-swatch compare-vadivam"></span>Vadivam</span>
              <span class="compare-key"><span class="compare-swatch compare-lucide"></span>Lucide</span>
            </div>
            <figcaption>Overlay</figcaption>
          </figure>
        </div>
        <p class="m-0 mt-2 text-xs text-muted-foreground">
          Same name, 24px grid, and 2px stroke, so swapping keeps your layout. Lucide drawing © Lucide Contributors, <a class="text-muted-foreground hover:text-foreground" href="https://github.com/lucide-icons/lucide/blob/main/LICENSE">ISC License</a>.
        </p>
      </section>
    )}

    {icon.tags.length > 0 && (
      <section class="mt-10" aria-labelledby="tagsHeading">
        <h2 class={sectionClass} id="tagsHeading">Tags</h2>
        <div class="mt-3 flex flex-wrap gap-1.5">
          {icon.tags.map((tag) => (
            <a class={chipClass} href={`/?q=${encodeURIComponent(tag)}`}>{tag}</a>
          ))}
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section class="mt-10" aria-labelledby="relatedHeading">
        <h2 class={sectionClass} id="relatedHeading">Related icons</h2>
        <div class="mt-3 grid grid-cols-3 gap-1 sm:grid-cols-6">
          {related.map((item) => (
            <a class="related-tile" href={`/icons/${item.name}`}>
              <span aria-hidden="true" set:html={item.svg} />
              <span class="related-name">{item.name}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="mt-10" aria-labelledby="moreHeading">
      <h2 class={sectionClass} id="moreHeading">Learn more</h2>
      <ul class="m-0 mt-3 list-none divide-y divide-border border-y border-border p-0">
        {guides.map((guide) => (
          <li class="m-0 p-0">
            <a class="group grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 gap-y-0.5 py-3 text-sm text-foreground no-underline sm:grid-cols-[9rem_minmax(0,1fr)_auto]" href={guide.href}>
              <span class="font-medium">{guide.title}</span>
              <span class="col-start-1 row-start-2 text-muted-foreground sm:col-start-2 sm:row-start-1">{guide.description}</span>
              <span class="col-start-2 row-span-2 row-start-1 text-muted-foreground transition-transform group-hover:translate-x-0.5 sm:col-start-3 sm:row-span-1"><VIcon name="arrow-right" size={14} /></span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>

  {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}

  <script is:inline type="application/json" id="snippetTemplates" set:html={serializeForScript(templates)}></script>
  <script is:inline type="application/json" id="iconData" set:html={serializeForScript({ icon: iconRef, version: pkg.version })}></script>

  <script>
    import {
      bindCustomizer,
      copyText,
      createSettingsStore,
      readTemplates,
      renderPreviews,
      runAction,
      snippetHtml,
      snippetText,
      wireMenus,
      type IconRef,
    } from "../_lib/icon-tools";

    // Astro's client router swaps pages without reloading and runs a bundled
    // script once, so set each icon page up on every page load.
    document.addEventListener("astro:page-load", () => {
      if (!document.querySelector("#iconDetail")) return;

      const detail = document.querySelector<HTMLElement>("#iconDetail")!;
      const status = document.querySelector<HTMLElement>("#pageStatus")!;
      const stage = document.querySelector<HTMLElement>("#previewStage")!;
      const gridToggle = document.querySelector<HTMLInputElement>("#pixelGrid")!;
      const overlay = document.querySelector<HTMLElement>("#pixelGridOverlay")!;
      const templates = readTemplates("snippetTemplates");
      const { icon, version } = JSON.parse(document.getElementById("iconData")?.textContent ?? "{}") as { icon: IconRef; version: string };
      const store = createSettingsStore({ url: true });
      const tabKey = "vadivam:tab";
      const backgroundKey = "vadivam:preview-background";
      let statusTimer: ReturnType<typeof setTimeout> | undefined;

      const setStatus = (message: string) => {
        status.textContent = message;
        clearTimeout(statusTimer);
        statusTimer = setTimeout(() => (status.textContent = ""), 2000);
      };

      const remember = (key: string, value: string) => {
        try {
          localStorage.setItem(key, value);
        } catch {
          // Storage can be unavailable; the choice still applies to this page.
        }
      };
      const recall = (key: string) => {
        try {
          return localStorage.getItem(key);
        } catch {
          return null;
        }
      };

      // Each tab group switches its own panels; the framework choice is remembered.
      const selectTab = (group: HTMLElement, id: string) => {
        const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
        if (!buttons.some((button) => button.dataset.tab === id)) return;
        for (const button of buttons) {
          const active = button.dataset.tab === id;
          button.setAttribute("aria-selected", String(active));
          const panel = document.getElementById(button.getAttribute("aria-controls") ?? "");
          if (panel) panel.hidden = !active;
        }
      };
      for (const group of detail.querySelectorAll<HTMLElement>("[data-tabgroup]")) {
        group.addEventListener("click", (event) => {
          const tab = (event.target as HTMLElement).closest<HTMLElement>('[role="tab"]')?.dataset.tab;
          if (!tab) return;
          selectTab(group, tab);
          if (group.dataset.tabgroup === "framework") remember(tabKey, tab);
        });
      }
      const frameworkGroup = detail.querySelector<HTMLElement>('[data-tabgroup="framework"]');
      if (frameworkGroup) selectTab(frameworkGroup, recall(tabKey) ?? "react");

      // One package manager choice rewrites every tab's install line.
      const managerKey = "vadivam:package-manager";
      const installCommand = (manager: string, packageName: string) =>
        `${manager} ${manager === "npm" ? "install" : "add"} ${packageName}`;
      const setManager = (manager: string) => {
        const buttons = Array.from(detail.querySelectorAll<HTMLElement>("[data-package-manager]"));
        if (!buttons.some((button) => button.dataset.packageManager === manager)) return;
        for (const button of buttons) button.setAttribute("aria-pressed", String(button.dataset.packageManager === manager));
        for (const line of detail.querySelectorAll<HTMLElement>("[data-install]")) {
          line.textContent = installCommand(manager, line.dataset.install ?? "");
        }
      };
      const currentManager = () =>
        detail.querySelector<HTMLElement>('[data-package-manager][aria-pressed="true"]')?.dataset.packageManager ?? "npm";
      detail.querySelector('[aria-label="Package manager"]')?.addEventListener("click", (event) => {
        const manager = (event.target as HTMLElement).closest<HTMLElement>("[data-package-manager]")?.dataset.packageManager;
        if (!manager) return;
        setManager(manager);
        remember(managerKey, manager);
      });
      setManager(recall(managerKey) ?? "npm");

      const setBackground = (value: string) => {
        stage.dataset.background = value;
        for (const button of detail.querySelectorAll<HTMLElement>("[data-background]")) {
          if (button !== stage) button.setAttribute("aria-pressed", String(button.dataset.background === value));
        }
      };
      detail.querySelector('[aria-label="Preview background"]')?.addEventListener("click", (event) => {
        const value = (event.target as HTMLElement).closest<HTMLElement>("[data-background]")?.dataset.background;
        if (!value) return;
        setBackground(value);
        remember(backgroundKey, value);
      });
      setBackground(recall(backgroundKey) ?? "auto");

      gridToggle.addEventListener("change", () => {
        overlay.hidden = !gridToggle.checked;
        remember("vadivam:pixel-grid", String(gridToggle.checked));
      });
      gridToggle.checked = recall("vadivam:pixel-grid") !== "false";
      overlay.hidden = !gridToggle.checked;

      const customizer = detail.querySelector<HTMLElement>("[data-customizer]");
      if (customizer) bindCustomizer(customizer, store);
      store.subscribe((settings) => {
        renderPreviews(detail, icon, settings);
        for (const panel of detail.querySelectorAll<HTMLElement>("[data-snippet]")) {
          panel.innerHTML = snippetHtml(templates, panel.dataset.snippet ?? "react", icon, settings);
        }
      });

      detail.addEventListener("click", async (event) => {
        const target = (event.target as HTMLElement).closest<HTMLElement>("[data-action]");
        if (!target) return;
        try {
          if (target.dataset.action === "copy-install") {
            await copyText(installCommand(currentManager(), target.dataset.package ?? ""));
            setStatus("Install command copied.");
          } else if (target.dataset.action === "copy-snippet") {
            await copyText(snippetText(target.dataset.snippetTab ?? "react", icon, store.get()));
            setStatus("Snippet copied.");
          } else if (target.dataset.action === "copy-code") {
            await copyText(target.dataset.copy ?? "");
            setStatus("Copied.");
          } else {
            setStatus(await runAction(target.dataset.action ?? "", icon, store.get(), version, stage));
          }
        } catch {
          setStatus("Couldn't complete that action in this browser.");
        }
      });

      wireMenus(detail);

      // PageLayout does not ship RootLayout's code-block copy island, so add a
      // copy button to each Blume CodeBlock (the SVG tab's asset imports).
      for (const pre of detail.querySelectorAll<HTMLElement>(".prose pre")) {
        const code = pre.querySelector("code");
        if (!code || pre.closest("[data-snippet]") || pre.querySelector("[data-action]")) continue;
        pre.classList.add("group", "relative");
        const button = document.createElement("button");
        button.type = "button";
        button.className =
          "absolute end-2 top-2 inline-flex items-center gap-1 rounded-md border border-border bg-background px-2 py-0.5 text-[0.68rem] opacity-0 transition-opacity hover:bg-muted focus-visible:opacity-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent group-hover:opacity-100";
        button.dataset.action = "copy-code";
        button.dataset.copy = code.textContent ?? "";
        button.setAttribute("aria-label", "Copy code");
        button.innerHTML = "<span>Copy</span>";
        pre.appendChild(button);
      }
    });
  </script>
</PageLayout>

